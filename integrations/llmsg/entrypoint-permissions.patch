+func TestAghEntrypointRepairsExistingHomeAndRefusesPermissionFailure(t *testing.T) {
+	env := runtimeEnv(t)
+	out, err := runBash(t, `
+mkdir -p -- "$AGH_HOME"
+printf 'preserved' > "$AGH_HOME/probe"
+chmod() { printf '%s\n' "$*" >> "$TEST_EVENTS"; command chmod "$@"; }
+`+entrypointPrefix(t)+`
+test "$(cat -- "$AGH_HOME/probe")" = preserved
+cat -- "$TEST_EVENTS"
+`, env)
+	require.NoError(t, err, out)
+	require.Contains(t, out, "0700 -- "+env["AGH_HOME"])
+	out, err = runBash(t, `chmod() { return 1; }
+`+entrypointPrefix(t)+`printf 'UNEXPECTED_CONTINUE'`, env)
+	require.Error(t, err, out)
+	require.NotContains(t, out, "UNEXPECTED_CONTINUE")
+}
