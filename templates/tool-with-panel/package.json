    "@types/node": "26.4.1",
    "tsx": "4.23.13",
    "@agnes/host": "0.0.0"
  },
  "agnes": {
    "plugins": [
      {
        "export": "main",
        "apiRange": "^1.4.0",
        "id": "ext:__PACKAGE_NAME__/main",
