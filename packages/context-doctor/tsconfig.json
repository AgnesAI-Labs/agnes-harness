{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": false,
    "jsx": "react-jsx"
  },
  "include": ["index.mjs", "src/*.mjs", "src/*.tsx", "test/*.ts", "test/*.tsx"],
  "exclude": ["src/client.js", "dist"],
  "references": [
    {
      "path": "../extension-api"
    },
    {
      "path": "../web-client"
    },
    {
      "path": "../web-ui"
    }
  ]
}
