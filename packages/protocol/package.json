{
  "name": "@agnes/protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./gen/*": "./gen/ts/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b",
    "gen": "tsx tools/gen.ts",
    "gen:check": "tsx tools/gen.ts --check",
    "conformance": "tsx tools/conformance.ts",
    "build:schema-cli": "node tools/build-author-schema-cli.mjs",
    "prepack": "node tools/build-author-schema-cli.mjs"
  },
  "dependencies": {
    "@agnes/resource-control-contracts": "workspace:*",
    "@agnes/protocol-validation": "workspace:*",
    "@sinclair/typebox": "0.34.33"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2"
  },
  "license": "Apache-2.0",
  "bin": {
    "agnes-schema": "./dist/schema-cli/agnes-schema.mjs"
  }
}
