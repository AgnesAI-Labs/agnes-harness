{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agnes.ai/schema/jobs.json",
  "title": "JobSpec / JobStatus (daemon \u7a3f \u00a711)",
  "$defs": {
    "JsonValue": {
      "$ref": "session-v1.json#/$defs/JsonValue"
    },
    "Schedule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "once"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "at"],
          "properties": {
            "kind": {
              "const": "at"
            },
            "at": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "everyMs"],
          "properties": {
            "kind": {
              "const": "every"
            },
            "everyMs": {
              "type": "integer",
              "minimum": 1000
            },
            "anchorMs": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "expr"],
          "properties": {
            "kind": {
              "const": "cron"
            },
            "expr": {
              "type": "string",
              "maxLength": 128
            },
            "tz": {
              "type": "string",
              "maxLength": 64
            },
            "staggerMs": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "JobSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotencyKey", "sessionKey", "payload", "schedule"],
      "properties": {
        "idempotencyKey": {
          "type": "string",
          "maxLength": 256
        },
        "sessionKey": {
          "type": "string",
          "maxLength": 512
        },
        "payload": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["prompt"],
              "properties": {
                "prompt": {
                  "oneOf": [
                    {
                      "type": "string",
                      "maxLength": 65536
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/ContentBlock"
                      }
                    }
                  ]
                },
                "delivery": {
                  "enum": ["steer", "follow_up"]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["command"],
              "properties": {
                "command": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["method", "params"],
                  "properties": {
                    "method": {
                      "type": "string",
                      "pattern": "^(?:resume|_agnes/v1/[A-Za-z][A-Za-z0-9./_-]*)$"
                    },
                    "params": {
                      "$ref": "#/$defs/JsonValue"
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "channel"],
              "properties": {
                "kind": {
                  "const": "directory.sync"
                },
                "channel": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "command", "cwd"],
              "properties": {
                "kind": {
                  "const": "shell"
                },
                "command": {
                  "type": "string",
                  "maxLength": 65536
                },
                "cwd": {
                  "type": "string",
                  "maxLength": 4096
                }
              }
            }
          ]
        },
        "schedule": {
          "$ref": "#/$defs/Schedule"
        },
        "budget": {
          "type": "number",
          "minimum": 0
        },
        "protected": {
          "type": "boolean"
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "JobStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId", "status", "attempts", "createdAt", "updatedAt"],
      "properties": {
        "jobId": {
          "type": "string"
        },
        "status": {
          "enum": ["waiting", "delayed", "active", "completed", "failed", "dead", "cancelled"]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "delayUntil": {
          "type": "integer",
          "minimum": 0
        },
        "leaseUntil": {
          "type": "integer",
          "minimum": 0
        },
        "stalledCounter": {
          "type": "integer",
          "minimum": 0
        },
        "result": {
          "$ref": "#/$defs/JsonValue"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ContentBlock": {
      "$ref": "session-v1.json#/$defs/ContentBlock"
    }
  }
}
