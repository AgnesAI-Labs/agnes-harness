{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agnes.ai/schema/projection.json",
  "$ref": "#/$defs/ProjectionCapability",
  "$defs": {
    "ProjectionCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "inputEventTypes", "maxStateBytes"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$",
          "maxLength": 128
        },
        "inputEventTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[./-][a-z0-9]+)*$"
          }
        },
        "maxStateBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        }
      }
    },
    "ProjectionReadResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "name", "asOfSeq", "stateVersion", "value"],
          "properties": {
            "status": {
              "const": "available"
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$",
              "maxLength": 128
            },
            "asOfSeq": {
              "type": "integer",
              "minimum": 0
            },
            "stateVersion": {
              "type": "integer",
              "minimum": 1
            },
            "value": {
              "$ref": "session-v1.json#/$defs/JsonValue"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "name", "error"],
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$",
              "maxLength": 128
            },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "safeMessage"],
              "properties": {
                "code": {
                  "const": "E_PROJECTION_STATE"
                },
                "safeMessage": {
                  "type": "string",
                  "maxLength": 256
                }
              }
            }
          }
        }
      ]
    }
  }
}
