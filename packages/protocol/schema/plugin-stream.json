{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agnes.ai/schema/plugin-stream.json",
  "title": "Authenticated plugin streams",
  "$ref": "#/$defs/StreamScope",
  "$defs": {
    "StreamScope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "profileId"],
          "properties": {
            "kind": {
              "const": "profile"
            },
            "profileId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "profileId", "sessionId", "laneId"],
          "properties": {
            "kind": {
              "const": "session"
            },
            "profileId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sessionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "laneId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      ]
    },
    "StreamDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scope",
        "inputSchema",
        "directions",
        "lane",
        "maxFrameBytes",
        "maxBufferedBytes",
        "maxBytesPerSecond"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$"
        },
        "scope": {
          "enum": ["profile", "session"]
        },
        "inputSchema": {
          "$ref": "tooldef.json#/$defs/ParametersSchema"
        },
        "directions": {
          "type": "array",
          "items": {
            "enum": ["outbound", "inbound"]
          },
          "maxItems": 2,
          "uniqueItems": true,
          "minItems": 1
        },
        "lane": {
          "enum": ["media", "control", "events"]
        },
        "maxFrameBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maxBufferedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        },
        "maxBytesPerSecond": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "readService": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$"
        },
        "controlService": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$"
        },
        "producer": {
          "const": true,
          "description": "Reviewed profile data producer, separate from human control admission."
        }
      }
    },
    "PluginStreamOpen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name", "scope", "input"],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$"
        },
        "scope": {
          "$ref": "plugin-stream.json#/$defs/StreamScope"
        },
        "input": {
          "$ref": "session-v1.json#/$defs/JsonValue"
        },
        "controlOperationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rowId", "revision", "contentDigest"],
          "properties": {
            "rowId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^web:[^\\x00]{1,251}$"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "contentDigest": {
              "type": "string",
              "pattern": "^sha256-[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "PluginStreamGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticket", "expiresAt", "path", "streamId", "lane"],
      "properties": {
        "ticket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "path": {
          "const": "/_agnes/plugin-stream"
        },
        "streamId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "lane": {
          "enum": ["media", "control", "events"]
        },
        "producer": {
          "const": true
        },
        "maxFrameBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maxBufferedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        }
      }
    },
    "PluginStreamClose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {
          "enum": ["closed", "revoked", "expired", "overloaded", "protocol", "unavailable", "reopen"]
        }
      }
    },
    "PluginStreamHello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticket"],
      "properties": {
        "ticket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "PluginStreamJsonFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "streamId", "sequence", "kind", "data"],
      "properties": {
        "version": {
          "const": 1
        },
        "streamId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "kind": {
          "const": "json"
        },
        "data": {
          "$ref": "session-v1.json#/$defs/JsonValue"
        }
      }
    }
  }
}
