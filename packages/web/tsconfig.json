{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "outDir": "dist",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "dist",
    "node_modules",
    "test",
    "testkit",
    "tools",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/test/**",
    "**/tests/**",
    "vitest.config.ts"
  ],
  "references": [
    {
      "path": "../base"
    },
    {
      "path": "../cordis"
    },
    {
      "path": "../protocol"
    },
    {
      "path": "../resource-control-web"
    },
    {
      "path": "../sdk"
    },
    {
      "path": "../web-admin-frame"
    },
    {
      "path": "../web-client"
    },
    {
      "path": "../web-foundation"
    },
    {
      "path": "../web-server"
    },
    {
      "path": "../web-ui"
    },
    {
      "path": "../web-units"
    }
  ]
}
