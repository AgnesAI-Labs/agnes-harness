        "path": "./src/agnes.client.json"
      }
    ],
    "metadata": {
      "displayName": "Files and deliverables",
      "summary": "View generated files, their history and the deliverables panel.",
      "description": "View generated files, their history and the deliverables panel.",
      "locales": {
        "zh-CN": {
