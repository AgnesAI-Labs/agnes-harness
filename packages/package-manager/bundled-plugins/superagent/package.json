{
  "name": "@agnes/superagent",
  "version": "0.2.5",
  "description": "A proactive agent for one GitHub repository, installed and enabled by default, waiting for configuration.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "prompts",
    "skills",
    "locale",
    "src",
    "client-build.json"
  ],
  "engines": {
    "node": ">=24.10"
  },
  "agnes": {
    "provides": [
      "tool",
      "service",
      "bundle"
    ],
    "plugins": [
      {
        "export": "superagentPlugin",
        "id": "ext:agnes.superagent/main",
        "runtime": "in-process",
        "apiRange": "^5.22.0",
        "inject": [
          "hooks",
          "tools",
          "services",
          "self",
          "profileRuntime"
        ],
        "configSchema": {
          "type": "object",
          "additionalProperties": false,
          "description": "Machine settings. Accounts, Sources, policy, prompts and the execution environment are saved in the Superagent panel.",
          "x-locales": {
            "zh-CN": {
              "description": "本机设置。账号、来源、策略、提示与执行环境在 Superagent 面板中保存。"
            }
          },
          "properties": {
            "stateDir": {
              "type": "string",
              "minLength": 2,
              "maxLength": 4096,
              "pattern": "^(/|[A-Za-z]:[\\\\/])",
              "description": "Directory for the database, locks, worker shims, the agent's git configuration and, by default, the ticket directories. Absolute path. Defaults to the private directory the platform gives Superagent."
            },
            "promptMaxChars": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 1000000,
              "default": 100000,
              "description": "Largest saved prompt configuration, in characters."
            },
            "admissionContextMaxPages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10,
              "description": "Pages of thread context one assessment may read."
            },
            "admissionContextTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90000,
              "default": 15000,
              "description": "Time limit of one context read during an assessment, in milliseconds."
            }
          }
        },
        "metadata": {
          "displayName": "Superagent",
          "summary": "A proactive agent for one GitHub repository: it assesses requests, opens tickets and works each in its own session.",
          "description": "Installed and enabled by default, waiting for configuration before any source, task or model runs. Once configured, Superagent watches one GitHub repository (and optionally Feishu chats through a configured bot lark-cli wrapper), assesses requests under its policy and turns authorized ones into tickets. Each ticket gets its own directory and a full-access session that commits as the configured agent account and pushes branches named agent/<short name>-<ticket id prefix>; it never merges. It runs with the profile owner's local client, keeps its database in a private platform directory and sends repository and chat content to the configured models.",
          "locales": {
            "zh-CN": {
              "displayName": "Superagent",
              "summary": "面向单个 GitHub 仓库的主动智能体：研判请求、开工单，并在各自会话中完成。",
              "description": "默认安装并启用，未配置时等待设置，不监听来源、不启动任务、不调用模型。配置后，Superagent 监听一个 GitHub 仓库（可选通过已配置的机器人 lark-cli 包装程序监听飞书群），按策略研判请求，把获授权的请求转为工单。每张工单有自己的目录和一个完全访问的会话，以配置的智能体账号提交并推送名为 agent/<短名>-<工单 id 前缀> 的分支，从不合并。它以 profile 主人的本地客户端运行，数据库放在平台给的私有目录，并把仓库与聊天内容发给所配置的模型。"
            }
          }
        },
