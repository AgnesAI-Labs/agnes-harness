{
  "name": "@agnes/browser-runtime",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "src",
    "dist",
    "NOTICE",
    "README.md",
    "LICENSE"
  ],
  "agnes": {
    "provides": [
      "tool",
      "ui"
    ],
    "plugins": [
      {
        "export": "browserRuntime",
        "id": "ext:browser-runtime/main",
        "apiRange": "^4.0.0",
        "runtime": "in-process",
        "inject": [
          "tools",
          "hooks",
          "services",
          "profileRuntime"
        ],
        "capabilities": {
          "ui": true,
          "store": true,
          "tools": {
            "prefix": "browser_"
          },
          "hooks": [
            "shutdown"
          ],
          "network": [
            "*"
          ],
          "exec": [
            "*agent-browser-*",
            "*chrome-headless-shell*",
            "*/curl",
            "*\\curl.exe",
            "*/tar",
            "*\\tar.exe"
          ],
          "filesystem": {
            "read": [
              "*/.agent-browser/agh-headless/*",
              "*\\.agent-browser\\agh-headless\\*",
              "*/agh-b-*/*",
              "*\\agh-b-*\\*",
              "*/dist/bin/*",
              "*\\dist\\bin\\*"
            ],
            "write": [
              "*/.agent-browser/agh-headless/*",
              "*\\.agent-browser\\agh-headless\\*",
              "*/agh-b-*/*",
              "*\\agh-b-*\\*"
            ]
          },
          "services": [
            {
              "name": "browser.observe",
              "scope": "profile",
              "kind": "query",
              "inputSchema": {
                "type": "object",
                "required": [
                  "sessionId"
                ],
                "properties": {
                  "sessionId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                },
                "additionalProperties": false
              },
              "outputSchema": {
                "type": "object",
                "additionalProperties": true
              },
              "timeoutMs": 5000,
              "maxResultBytes": 16384
            }
          ],
          "streams": [
            {
              "name": "browser.frames",
              "scope": "profile",
              "directions": [
                "outbound"
              ],
              "lane": "media",
              "inputSchema": {
                "type": "object",
                "required": [
                  "ticket"
                ],
                "properties": {
                  "ticket": {
                    "type": "string",
                    "minLength": 36,
                    "maxLength": 36
                  }
                },
                "additionalProperties": false
              },
              "maxFrameBytes": 1048576,
              "maxBufferedBytes": 1048576,
              "maxBytesPerSecond": 4194304
            }
          ],
          "managedServices": [
            {
              "id": "browser",
              "scope": "profile",
              "artifact": {
                "kind": "in-process"
              },
              "apiVersion": "1.0.0",
              "healthPath": "/health",
              "listeners": [],
              "requires": [],
              "startupTimeoutMs": 10000,
              "shutdownTimeoutMs": 5000
            }
          ]
        },
        "metadata": {
          "displayName": "内置浏览器 / Built-in browser",
          "summary": "独立浏览器工具和右侧实时预览，首次默认关闭。",
          "description": "手动启用后新建会话即可使用，重启记住选择。只操作 AGH 独立浏览器，不接管个人浏览器或桌面。"
        }
      }
    ],
    "clientDescriptors": [
      {
        "rowId": "ext:browser-runtime/main",
        "path": "./src/agnes.client.json"
      }
    ],
    "metadata": {
      "displayName": "内置浏览器 / Built-in browser",
      "summary": "独立浏览器工具和右侧实时预览，首次默认关闭。",
      "description": "手动启用后新建会话即可使用，重启记住选择。只操作 AGH 独立浏览器，不接管个人浏览器或桌面。"
    }
  },
  "peerDependencies": {
    "@agnes/web-client": "0.0.0",
    "@agnes/web-ui": "0.0.0",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@agnes/web-client": "workspace:*",
    "agent-browser": "0.39.1",
    "@agnes/web-ui": "workspace:*",
    "react": "18.3.1"
  }
}
