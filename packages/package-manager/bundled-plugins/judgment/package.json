{
  "name": "@agnes/judgment",
  "version": "0.1.0",
  "description": "Optional detection of replies that promise to act but end early.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "src",
    "client-build.json",
    "LICENSE.oh-my-pi"
  ],
  "engines": {
    "node": ">=24.10"
  },
  "agnes": {
    "plugins": [
      {
        "export": "judgmentPlugin",
        "id": "ext:agnes.judgment/main",
        "runtime": "in-process",
        "configReload": "next-session",
        "apiRange": "^5.20.0",
        "inject": [
          "hooks",
          "projections",
          "eventLog",
          "sideCall",
          "services",
          "self",
          "tools",
          "sessionWork"
        ],
        "configSchema": {
          "type": "object",
          "additionalProperties": false,
          "description": "Configure a Jev key to make judgment available; unexpected-stop detection requires separate opt-in and is off by default.",
          "x-locales": {
            "zh-CN": {
              "description": "填上 Jev 的 key 即可启用判断模型；意外收工检测默认关闭，需要另外手动开启。"
            }
          },
          "properties": {
            "judge": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "route": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "description": "Configured side-model route."
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "description": "Model id on the selected route."
                },
                "fallback": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "route": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "description": "Configured side-model route."
                    },
                    "model": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "description": "Model id on the selected route."
                    }
                  },
                  "required": [
                    "route",
                    "model"
                  ],
                  "description": "Optional native fallback; never a chat fallback."
                }
              }
            },
            "uses": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "find": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "default": false,
                      "description": "Opt in to redacted model judgment. Human effectiveness evaluation has not been performed."
                    }
                  }
                },
                "batch": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "default": false,
                      "description": "Opt in to redacted model judgment. Human effectiveness evaluation has not been performed."
                    }
                  }
                },
                "rules": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "default": false,
                      "description": "Opt in to native rule reminders after configured exact tool results."
                    },
                    "items": {
                      "type": "array",
                      "maxItems": 32,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "text",
                          "tools"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                          },
                          "text": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1000
                          },
                          "tools": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 16,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "title": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "default": false,
                      "description": "Opt in to background automatic-title drift checks.",
                      "x-locales": {
                        "zh-CN": {
                          "description": "手动开启后台自动标题漂移检查。"
                        }
                      }
                    },
                    "refreshAfterPrompts": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991,
                      "default": 0,
                      "description": "Check after this many meaningful operator prompts; zero disables checks.",
                      "x-locales": {
                        "zh-CN": {
                          "description": "累计指定次数的有效操作者提示后检查；0 表示关闭。"
                        }
                      }
                    }
                  }
                },
                "stop": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "default": false,
                      "description": "Opt in to unexpected-stop detection. Real-session effectiveness has not been evaluated.",
                      "x-locales": {
                        "zh-CN": {
                          "description": "手动开启意外收工检测。真实会话效果尚未评测。"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "metadata": {
          "displayName": "Judgment",
          "summary": "Optional stop detection, source finding, batch judgment, rule reminders and settings.",
          "description": "All uses are off by default. Stop detection sends redacted request/reply excerpts (2,000/8,000 characters). find_relevant locally scans workspace files and sends redacted query, candidate paths, summaries (256 original characters) and source windows (8 KiB each) from at most 20 fresh 1 MiB file prefixes. judge_batch sends up to 500 redacted JSON states plus redacted question text; unsafe question or choice identifiers are refused. Each declared raw item and complete shared questions object is limited to 1 MiB serialized UTF-8 JSON before masking; preparation yields to cancellation. Remote providers receive remaining content; redaction does not remove all confidential information. Native probabilities and text decisions differ. Human effectiveness evaluations have not been performed. Rule reminders are separately disabled by default; when enabled, they send configured rule text, the first 2,000 characters of tool arguments and last 8,000 characters of text output after full-context credential masking. The profile settings page exposes only current-instance status and bounded counters. Background title refresh is separately disabled by default (cadence 0); enabling it sends cleaned recent conversation for judgment (3000 UTF-16 characters, 1000 per turn) and a fresh bounded title-generation context (2000 characters), including plain assistant thinking only for generation, after full-context credential masking.",
          "locales": {
            "zh-CN": {
              "displayName": "判断",
              "summary": "可选的收工检测、源码查找、批量判断、规则提醒与设置。",
              "description": "全部用途默认关闭。收工检测发送遮蔽后的请求/回复摘录（2,000/8,000 字符）。find_relevant 在工作区本地扫描后，发送遮蔽后的查询、候选路径、摘要（256 原始字符）和源码窗口（每段 8 KiB），最多来自 20 个文件各自新读的前 1 MiB。judge_batch 发送最多 500 条遮蔽后的 JSON 状态及题目文本；含凭据的题目或选项标识整批拒绝。遮蔽前，原始条目及完整共享题目对象按序列化 UTF-8 JSON 各限 1 MiB，准备阶段可取消。远程服务会收到剩余内容，遮蔽不能移除所有机密。原生概率与文字决策不同；真实人工效果评测尚未执行。 规则提醒默认另行关闭；开启后发送配置规则正文、工具参数前 2,000 字符与文本结果后 8,000 字符，均先按完整上下文遮蔽凭据。设置页仅展示当前实例状态和有限计数。 后台标题刷新默认另行关闭（间隔为 0）；开启后先按完整上下文遮蔽凭据，再发送清理后的近期会话供判断（总计 3000 个 UTF-16 字符，每轮最多 1000）及最新标题生成上下文（最多 2000 字符），明文助手思考仅用于生成。"
            }
          }
        },
        "capabilities": {
          "hooks": [
            "turn_stopping",
            "tool_result"
          ],
          "events": true,
          "projections": [
            {
              "name": "stop.conversation",
              "inputEventTypes": [
                "session/start",
                "user/message",
                "assistant/message",
                "inbox",
                "x/plugin/524280817e87343c/stop.continued"
              ],
              "maxStateBytes": 262144
            },
            {
              "name": "rules.reminders",
              "inputEventTypes": [
                "session/start",
                "x/plugin/524280817e87343c/rules.reminded"
              ],
              "maxStateBytes": 150000
            },
            {
              "name": "tools.session",
              "inputEventTypes": [
                "session/start"
              ],
              "maxStateBytes": 256
            },
            {
              "name": "title.context",
              "inputEventTypes": [
                "session/start",
                "user/message",
                "assistant/message"
              ],
              "maxStateBytes": 230968
            }
          ],
          "ui": true,
          "services": [
            {
              "name": "judgment.status",
              "kind": "query",
              "scope": "profile",
              "timeoutMs": 1000,
              "maxResultBytes": 4096,
              "inputSchema": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {}
              },
              "outputSchema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "configurationRevision",
                  "state",
                  "reason",
                  "hookTimeout",
                  "cache",
                  "uses"
                ],
                "properties": {
                  "version": {
                    "const": 1
                  },
                  "configurationRevision": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "state": {
                    "enum": [
                      "ready",
                      "unconfigured",
                      "unavailable"
                    ]
                  },
                  "reason": {
                    "enum": [
                      "none",
                      "model-not-configured",
                      "model-unavailable",
                      "ambiguous-model",
                      "authorization-unavailable"
                    ]
                  },
                  "hookTimeout": {
                    "const": "unknown"
                  },
                  "cache": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "hit",
                      "miss",
                      "size"
                    ],
                    "properties": {
                      "hit": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "miss": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "size": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 2000
                      }
                    }
                  },
                  "uses": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "stop",
                      "findRelevant",
                      "judgeBatch",
                      "rules"
                    ],
                    "properties": {
                      "stop": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "enabled",
                          "available",
                          "reason",
                          "requests"
                        ],
                        "properties": {
                          "enabled": {
                            "type": "boolean"
                          },
                          "available": {
                            "type": "boolean"
                          },
                          "reason": {
                            "enum": [
                              "none",
                              "disabled",
                              "native-required",
                              "model-unavailable",
                              "authorization-unavailable"
                            ]
                          },
                          "requests": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        }
                      },
                      "findRelevant": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "enabled",
                          "available",
                          "reason",
                          "requests"
                        ],
                        "properties": {
                          "enabled": {
                            "type": "boolean"
                          },
                          "available": {
                            "type": "boolean"
                          },
                          "reason": {
                            "enum": [
                              "none",
                              "disabled",
                              "native-required",
                              "model-unavailable",
                              "authorization-unavailable"
                            ]
                          },
                          "requests": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        }
                      },
                      "judgeBatch": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "enabled",
                          "available",
                          "reason",
                          "requests"
                        ],
                        "properties": {
                          "enabled": {
                            "type": "boolean"
                          },
                          "available": {
                            "type": "boolean"
                          },
                          "reason": {
                            "enum": [
                              "none",
                              "disabled",
                              "native-required",
                              "model-unavailable",
                              "authorization-unavailable"
                            ]
                          },
                          "requests": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        }
                      },
                      "rules": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "enabled",
                          "available",
                          "reason",
                          "requests"
                        ],
                        "properties": {
                          "enabled": {
                            "type": "boolean"
                          },
                          "available": {
                            "type": "boolean"
                          },
                          "reason": {
                            "enum": [
                              "none",
                              "disabled",
                              "native-required",
                              "model-unavailable",
                              "authorization-unavailable"
                            ]
                          },
                          "requests": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          ],
          "tools": {
            "prefix": "",
            "names": [
              "find_relevant",
              "judge_batch"
            ]
          },
          "filesystem": {
            "read": [
              "**"
            ]
          },
          "sessionWork": true,
          "autoTitle": true
        }
      }
    ],
    "metadata": {
      "displayName": "Judgment",
      "summary": "Optional stop detection, source finding, batch judgment, rule reminders and settings.",
      "description": "All uses are off by default. Stop detection sends redacted request/reply excerpts (2,000/8,000 characters). find_relevant locally scans workspace files and sends redacted query, candidate paths, summaries (256 original characters) and source windows (8 KiB each) from at most 20 fresh 1 MiB file prefixes. judge_batch sends up to 500 redacted JSON states plus redacted question text; unsafe question or choice identifiers are refused. Each declared raw item and complete shared questions object is limited to 1 MiB serialized UTF-8 JSON before masking; preparation yields to cancellation. Remote providers receive remaining content; redaction does not remove all confidential information. Native probabilities and text decisions differ. Human effectiveness evaluations have not been performed. Rule reminders are separately disabled by default; when enabled, they send configured rule text, the first 2,000 characters of tool arguments and last 8,000 characters of text output after full-context credential masking. The profile settings page exposes only current-instance status and bounded counters. Background title refresh is separately disabled by default (cadence 0); enabling it sends cleaned recent conversation for judgment (3000 UTF-16 characters, 1000 per turn) and a fresh bounded title-generation context (2000 characters), including plain assistant thinking only for generation, after full-context credential masking.",
