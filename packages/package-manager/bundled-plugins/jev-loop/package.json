{
  "name": "@agnes/jev-loop",
  "version": "0.1.4",
  "description": "Agent loop driven by a configured decision model",
  "type": "module",
  "license": "Apache-2.0",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24.10"
  },
  "agnes": {
    "plugins": [
      {
        "export": "jevLoopPlugin",
        "id": "ext:agnes.jev/loop",
        "inject": [
          "providers"
        ],
        "runtime": "in-process",
        "apiRange": "^5.0.0",
        "configReload": "next-session",
        "configSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jev": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "route": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "default": "jev",
                  "description": "Side-call route that serves the Jev model.",
                  "x-locales": {
                    "zh-CN": {
                      "description": "提供 Jev 模型的决策模型路由。"
                    }
                  }
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "default": "typesafe/jev-1.13-20260917",
                  "description": "Model id on that route. Pin a dated version.",
                  "x-locales": {
                    "zh-CN": {
                      "description": "该路由上的模型 ID，请固定为带日期的版本。"
                    }
                  }
                },
                "deadlineMs": {
                  "type": "integer",
                  "minimum": 1000,
                  "maximum": 120000,
                  "default": 15000
                },
                "maxRetries": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3,
                  "default": 2
                }
              }
            },
            "llmMaxAttempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "default": 2
            },
            "thresholds": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "escalate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "default": 0.5
                },
                "externalWriteMin": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "default": 0.6
                },
                "ambiguityGate": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1,
                  "default": 0.4
                },
                "answerProgressFloor": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 3,
                  "default": null
                }
              }
            },
            "stepCap": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 30
            },
            "stateTokenBudget": {
              "type": "integer",
              "minimum": 4000,
              "maximum": 30000,
              "default": 24000
            },
            "requestTokenBudget": {
              "type": "integer",
              "minimum": 8000,
              "maximum": 60000,
              "default": 48000
            }
          }
        },
        "metadata": {
          "displayName": "jev",
          "summary": "Uses a decision model such as Agnes Sys1 to choose each step. The conversation model writes, fills in arguments or reviews.",
          "description": "Uses a configured decision model to choose each step. Select an Agnes Sys1 or Jev route. The conversation model writes, fills in arguments or reviews.",
          "locales": {
            "zh-CN": {
              "displayName": "jev",
              "summary": "由决策模型选择每一步，可配置 Agnes Sys1。对话模型负责撰写、补参数和复核。",
              "description": "由已配置的决策模型选择每一步，可选 Agnes Sys1 或 Jev。只在撰写、补参数或复核时调用对话模型。"
            }
          }
        }
      }
    ],
    "metadata": {
      "displayName": "jev",
      "summary": "Uses a decision model such as Agnes Sys1 to choose each step. The conversation model writes, fills in arguments or reviews.",
      "description": "Uses a configured decision model to choose each step. Select an Agnes Sys1 or Jev route. The conversation model writes, fills in arguments or reviews.",
      "locales": {
        "zh-CN": {
          "displayName": "jev",
          "summary": "由决策模型选择每一步，可配置 Agnes Sys1。对话模型负责撰写、补参数和复核。",
          "description": "由已配置的决策模型选择每一步，可选 Agnes Sys1 或 Jev。只在撰写、补参数或复核时调用对话模型。"
        }
      }
    },
    "provides": [
      "loop"
    ],
    "hostProvidedExternals": {
      "@agnes/extension-api": "^5.0.0"
    }
  }
}
