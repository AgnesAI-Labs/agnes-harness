{
  "version": 1,
  "events": {
    "PreToolUse": {
      "to": ["tool_call"],
      "fields": {
        "in": { "tool_name": "name", "tool_input": "args" },
        "out": { "permissionDecision": "allow", "permissionDecisionReason": "reason" }
      },
      "unsupportedFields": ["updatedInput"]
    },
    "PostToolUse": {
      "to": ["tool_result"],
      "fields": {
        "in": { "tool_name": "name", "tool_input": "args", "tool_response": "result" },
        "out": {
          "additionalContext": "result.content[]",
          "decision": "result.content[] (block marker)",
          "reason": "result.content[] (block marker)"
        }
      }
    },
    "PostToolUseFailure": {
      "to": ["tool_result"],
      "fields": {
        "in": { "tool_name": "name", "tool_input": "args", "error": "result.content[]" },
        "out": { "additionalContext": "result.content[]" }
      }
    },
    "Notification": {
      "to": null,
      "reason": "UI notification; no harness event"
    },
    "UserPromptSubmit": {
      "to": ["before_step", "context"],
      "fields": {
        "in": {},
        "out": {
          "decision": "before_step.block",
          "reason": "before_step.reason",
          "additionalContext": "context.additionalContext"
        }
      },
      "unsupportedFields": ["prompt"],
      "reason": "the current before_step/context payloads expose no user-message text"
    },
    "SessionStart": {
      "to": ["session_start"],
      "fields": {
        "in": {
          "source": "reason (startup/clear→new, resume→resume; compact unavailable)",
          "session_id": "$context.session.key",
          "cwd": "cwd"
        },
        "out": {}
      },
      "unsupportedFields": ["additionalContext"],
      "reason": "session_start currently returns null; source=compact has no legal reason value"
    },
    "SessionEnd": {
      "to": ["shutdown"],
      "fields": { "in": { "reason": "reason" }, "out": {} }
    },
    "Stop": {
      "to": ["turn_stopping"],
      "fields": {
        "in": { "stop_hook_active": "$context.replayed" },
        "out": { "decision": "action", "reason": "note" }
      }
    },
    "StopFailure": {
      "to": null,
      "reason": "error path is turn/end{error}, not a hook"
    },
    "SubagentStart": {
      "to": ["subagent_start"],
      "fields": {
        "in": { "agent_id": "childKey", "agent_type": "kind (fork/spawn only)" },
        "out": {}
      },
      "unsupportedFields": ["prompt"],
      "reason": "subagent_start has no prompt field"
    },
    "SubagentStop": {
      "to": ["subagent_end"],
      "fields": { "in": { "agent_id": "childKey" }, "out": {} },
      "unsupportedFields": ["decision"]
    },
    "PreCompact": {
      "to": ["before_compact"],
      "fields": {
        "in": {
          "trigger": "reason (manual→requested, auto→threshold)",
          "custom_instructions": "customInstructions"
        },
        "out": {}
      }
    },
    "PostCompact": {
      "to": ["compact"],
      "fields": { "in": {}, "out": {} }
    },
    "PermissionRequest": {
      "to": ["approval_request"],
      "fields": {
        "in": {
          "tool_name": "request.tool",
          "tool_input": "request.argvHash (sha256 of canonical JSON)"
        },
        "out": {}
      },
      "unsupportedFields": ["decision", "updatedPermissions"],
      "reason": "approval_request can refine risk/context but cannot return an approval verdict"
    },
    "PermissionDenied": {
      "to": null,
      "reason": "already an approval/decided event"
    },
    "Setup": {
      "to": null,
      "reason": "install-time action; package lifecycle is not exposed to extensions"
    },
    "TeammateIdle": {
      "to": null,
      "reason": "Claude Code team model; harness has a jobs table instead"
    },
    "TaskCreated": {
      "to": null,
      "reason": "Claude Code task model; harness has a jobs table instead"
    },
    "TaskCompleted": {
      "to": null,
      "reason": "Claude Code task model; harness has a jobs table instead"
    },
    "Elicitation": {
      "to": null,
      "reason": "MCP elicitation is declined in v0.1"
    },
    "ElicitationResult": {
      "to": null,
      "reason": "MCP elicitation is declined in v0.1"
    },
    "ConfigChange": {
      "to": null,
      "reason": "profile change requires restart"
    },
    "WorktreeCreate": {
      "to": null,
      "reason": "worktree is a subagent-internal contract"
    },
    "WorktreeRemove": {
      "to": null,
      "reason": "worktree is a subagent-internal contract"
    },
    "InstructionsLoaded": {
      "to": null,
      "reason": "AGENTS.md is already visible in the context hook"
    },
    "CwdChanged": {
      "to": null,
      "reason": "session cwd is fixed"
    },
    "FileChanged": {
      "to": null,
      "reason": "no file watcher"
    }
  }
}
