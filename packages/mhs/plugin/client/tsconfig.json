{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "outDir": "../../dist/client",
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "tsBuildInfoFile": "../../dist/client.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
