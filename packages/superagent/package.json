{
  "name": "@agnes/superagent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./panel-api": "./src/runtime/panel-api.ts"
  },
  "dependencies": {
    "@agnes/extension-api": "workspace:*",
    "@agnes/protocol": "workspace:*",
    "@agnes/sdk": "workspace:*",
    "zod": "4.5.4"
  },
  "license": "Apache-2.0 AND MIT",
  "agnes": {
    "provides": [
      "tool",
      "service",
      "bundle"
    ],
    "plugins": [
      {
        "export": "superagentPlugin",
        "id": "ext:agnes.superagent/main",
        "runtime": "in-process",
        "apiRange": "^5.22.0",
        "inject": [
          "hooks",
          "tools",
          "services",
          "self",
          "profileRuntime"
        ],
        "configSchema": {
          "type": "object",
          "additionalProperties": false,
          "description": "Machine settings. Accounts, Sources, policy, prompts and the execution environment are saved in the Superagent panel.",
          "x-locales": {
            "zh-CN": {
              "description": "本机设置。账号、来源、策略、提示与执行环境在 Superagent 面板中保存。"
            }
          },
          "properties": {
            "stateDir": {
              "type": "string",
              "minLength": 2,
              "maxLength": 4096,
              "pattern": "^/",
              "description": "Directory for the database, locks, worker shims, the agent's git configuration and, by default, the ticket directories. Absolute path. Defaults to the private directory the platform gives Superagent."
            },
            "promptMaxChars": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 1000000,
              "default": 100000,
              "description": "Largest saved prompt configuration, in characters."
            },
            "admissionContextMaxPages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10,
              "description": "Pages of thread context one assessment may read."
            },
            "admissionContextTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90000,
              "default": 15000,
              "description": "Time limit of one context read during an assessment, in milliseconds."
            }
          }
        },
        "metadata": {
          "displayName": "Superagent",
          "summary": "A proactive agent for one GitHub repository: it assesses requests, opens tickets and works each in its own session.",
          "description": "Not installed or enabled by default. Superagent watches one GitHub repository (and optionally Feishu group chats through an AGH channel), assesses requests under its policy and turns authorized ones into tickets. Each ticket gets its own directory and a full-access session that commits as the configured agent account and pushes agent/<ticket> branches; it never merges. It runs with the profile owner's local client, keeps its database in a private platform directory and sends repository and chat content to the configured models.",
          "locales": {
            "zh-CN": {
              "displayName": "Superagent",
              "summary": "面向单个 GitHub 仓库的主动智能体：研判请求、开工单，并在各自会话中完成。",
              "description": "默认不安装、不启用。Superagent 监听一个 GitHub 仓库（可选经 AGH 渠道监听飞书群），按策略研判请求，把获授权的请求转为工单。每张工单有自己的目录和一个完全访问的会话，以配置的智能体账号提交并推送 agent/<工单> 分支，从不合并。它以 profile 主人的本地客户端运行，数据库放在平台给的私有目录，并把仓库与聊天内容发给所配置的模型。"
            }
          }
        },
        "capabilities": {
          "store": true,
          "hooks": [
            "context",
            "tool_call"
          ],
          "tools": {
            "prefix": "orchestrator_",
            "names": [
