        )",
        "tbl_name": "session_principal_ownership",
        "type": "table",
      },
      {
        "name": "session_workspaces",
        "sql": "CREATE TABLE session_workspaces (
        session_key TEXT PRIMARY KEY,
        cwd TEXT NOT NULL,
        created_at TEXT,
        last_seq INTEGER NOT NULL DEFAULT 0,
        generation INTEGER NOT NULL DEFAULT 0,
        preset TEXT,
        profile_hash TEXT,
        title TEXT,
        last_active_at TEXT,
        loop_pin TEXT,
        message_at INTEGER,
        message_seq INTEGER NOT NULL DEFAULT 0,
        sidebar_sort_at INTEGER NOT NULL DEFAULT 0,
        sidebar_failed INTEGER NOT NULL DEFAULT 0,
        sidebar_group TEXT NOT NULL DEFAULT 'unassigned',
        sidebar_target_seq INTEGER NOT NULL DEFAULT 0
      )",
        "tbl_name": "session_workspaces",
        "type": "table",
      },
      {
        "name": "sidebar_versions",
        "sql": "CREATE TABLE sidebar_versions (
    principal_id TEXT NOT NULL, group_id TEXT NOT NULL, revision INTEGER NOT NULL DEFAULT 1,
    PRIMARY KEY (principal_id, group_id))",
        "tbl_name": "sidebar_versions",
        "type": "table",
      },
      {
        "name": "sqlite_sequence",
        "sql": "CREATE TABLE sqlite_sequence(name,seq)",
        "tbl_name": "sqlite_sequence",
        "type": "table",
      },
