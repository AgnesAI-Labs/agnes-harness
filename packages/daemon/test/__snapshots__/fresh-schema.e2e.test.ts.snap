  heartbeat INTEGER,
  stalled_counter INTEGER NOT NULL DEFAULT 0,
  budget REAL,
  protected INTEGER NOT NULL DEFAULT 0,
  result TEXT,
  error TEXT,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
)",
        "tbl_name": "jobs",
        "type": "table",
      },
      {
        "name": "plugin_config_audit",
