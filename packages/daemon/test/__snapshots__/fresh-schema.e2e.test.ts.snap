      {
        "name": "workspace_registry",
        "sql": "CREATE TABLE workspace_registry (
        path TEXT PRIMARY KEY,
        name TEXT NOT NULL,
        workspace_id TEXT NOT NULL,
        revision INTEGER NOT NULL,
        registered_at TEXT NOT NULL,
        last_used_at TEXT,
        listed INTEGER NOT NULL DEFAULT 1
      )",
        "tbl_name": "workspace_registry",
        "type": "table",
      },
      {
        "name": "sidebar_ownership_delete",
        "sql": "CREATE TRIGGER sidebar_ownership_delete AFTER DELETE ON session_principal_ownership BEGIN UPDATE sidebar_versions SET revision = revision + 1 WHERE group_id IN ((SELECT sidebar_group FROM session_workspaces WHERE session_key = OLD.session_id), (SELECT 'pinned' FROM session_preferences WHERE session_key = OLD.session_id AND pinned_at IS NOT NULL))
       AND principal_id IN (OLD.principal_id); END",
        "tbl_name": "session_principal_ownership",
        "type": "trigger",
      },
      {
        "name": "sidebar_ownership_insert",
        "sql": "CREATE TRIGGER sidebar_ownership_insert AFTER INSERT ON session_principal_ownership BEGIN UPDATE sidebar_versions SET revision = revision + 1 WHERE group_id IN ((SELECT sidebar_group FROM session_workspaces WHERE session_key = NEW.session_id), (SELECT 'pinned' FROM session_preferences WHERE session_key = NEW.session_id AND pinned_at IS NOT NULL))
       AND principal_id IN (NEW.principal_id); END",
        "tbl_name": "session_principal_ownership",
        "type": "trigger",
      },
      {
        "name": "sidebar_ownership_update",
        "sql": "CREATE TRIGGER sidebar_ownership_update AFTER UPDATE ON session_principal_ownership WHEN OLD.reservation_state IS NOT NEW.reservation_state OR OLD.principal_id IS NOT NEW.principal_id BEGIN UPDATE sidebar_versions SET revision = revision + 1 WHERE group_id IN ((SELECT sidebar_group FROM session_workspaces WHERE session_key = NEW.session_id), (SELECT 'pinned' FROM session_preferences WHERE session_key = NEW.session_id AND pinned_at IS NOT NULL))
       AND principal_id IN (OLD.principal_id, NEW.principal_id); END",
        "tbl_name": "session_principal_ownership",
        "type": "trigger",
      },
      {
        "name": "sidebar_preferences_delete",
        "sql": "CREATE TRIGGER sidebar_preferences_delete AFTER DELETE ON session_preferences WHEN OLD.archived != 0 OR OLD.pinned_at IS NOT NULL BEGIN UPDATE sidebar_versions SET revision = revision + 1
    WHERE principal_id IN (SELECT principal_id FROM session_principal_ownership WHERE session_id = OLD.session_key)
    AND group_id IN ((SELECT sidebar_group FROM session_workspaces WHERE session_key = OLD.session_key), CASE WHEN OLD.pinned_at IS NOT NULL THEN 'pinned' END); END",
        "tbl_name": "session_preferences",
        "type": "trigger",
      },
      {
        "name": "sidebar_preferences_insert",
        "sql": "CREATE TRIGGER sidebar_preferences_insert AFTER INSERT ON session_preferences WHEN NEW.archived != 0 OR NEW.pinned_at IS NOT NULL BEGIN UPDATE sidebar_versions SET revision = revision + 1
    WHERE principal_id IN (SELECT principal_id FROM session_principal_ownership WHERE session_id = NEW.session_key)
    AND group_id IN ((SELECT sidebar_group FROM session_workspaces WHERE session_key = NEW.session_key), CASE WHEN NEW.pinned_at IS NOT NULL THEN 'pinned' END); END",
        "tbl_name": "session_preferences",
        "type": "trigger",
      },
      {
        "name": "sidebar_preferences_update",
        "sql": "CREATE TRIGGER sidebar_preferences_update AFTER UPDATE ON session_preferences WHEN OLD.archived IS NOT NEW.archived OR OLD.pinned_at IS NOT NEW.pinned_at BEGIN UPDATE sidebar_versions SET revision = revision + 1
    WHERE principal_id IN (SELECT principal_id FROM session_principal_ownership WHERE session_id = NEW.session_key)
    AND group_id IN ((SELECT sidebar_group FROM session_workspaces WHERE session_key = NEW.session_key), CASE WHEN OLD.pinned_at IS NOT NULL OR NEW.pinned_at IS NOT NULL THEN 'pinned' END); END",
        "tbl_name": "session_preferences",
        "type": "trigger",
      },
      {
        "name": "sidebar_session_delete",
        "sql": "CREATE TRIGGER sidebar_session_delete AFTER DELETE ON session_workspaces BEGIN UPDATE sidebar_versions SET revision = revision + 1
    WHERE principal_id IN (SELECT principal_id FROM session_principal_ownership WHERE session_id = OLD.session_key)
    AND group_id IN (OLD.sidebar_group, (SELECT 'pinned' FROM session_preferences WHERE session_key = OLD.session_key AND pinned_at IS NOT NULL)); END",
        "tbl_name": "session_workspaces",
        "type": "trigger",
      },
      {
        "name": "sidebar_session_insert",
        "sql": "CREATE TRIGGER sidebar_session_insert AFTER INSERT ON session_workspaces BEGIN 
    UPDATE session_workspaces SET sidebar_group = COALESCE(
      (SELECT workspace_id FROM workspace_registry WHERE path = NEW.cwd AND listed = 1), 'unassigned') WHERE session_key = NEW.session_key;
    UPDATE sidebar_versions SET revision = revision + 1
    WHERE principal_id IN (SELECT principal_id FROM session_principal_ownership WHERE session_id = NEW.session_key)
    AND group_id IN ((SELECT sidebar_group FROM session_workspaces WHERE session_key = NEW.session_key), (SELECT 'pinned' FROM session_preferences WHERE session_key = NEW.session_key AND pinned_at IS NOT NULL)); END",
        "tbl_name": "session_workspaces",
        "type": "trigger",
      },
      {
        "name": "sidebar_session_update",
        "sql": "CREATE TRIGGER sidebar_session_update AFTER UPDATE ON session_workspaces WHEN
    OLD.sidebar_group IS NOT NEW.sidebar_group OR OLD.sidebar_sort_at IS NOT NEW.sidebar_sort_at OR
    OLD.created_at IS NOT NEW.created_at OR
    (OLD.message_seq = OLD.last_seq AND OLD.message_seq >= OLD.sidebar_target_seq) IS NOT
    (NEW.message_seq = NEW.last_seq AND NEW.message_seq >= NEW.sidebar_target_seq) OR OLD.sidebar_failed IS NOT NEW.sidebar_failed BEGIN UPDATE sidebar_versions SET revision = revision + 1
    WHERE principal_id IN (SELECT principal_id FROM session_principal_ownership WHERE session_id = NEW.session_key)
    AND group_id IN (OLD.sidebar_group, NEW.sidebar_group, (SELECT 'pinned' FROM session_preferences WHERE session_key = NEW.session_key AND pinned_at IS NOT NULL)); END",
        "tbl_name": "session_workspaces",
        "type": "trigger",
      },
      {
        "name": "sidebar_workspace_delete",
        "sql": "CREATE TRIGGER sidebar_workspace_delete AFTER DELETE ON workspace_registry BEGIN UPDATE session_workspaces SET sidebar_group = 'unassigned' WHERE cwd = OLD.path; END",
        "tbl_name": "workspace_registry",
        "type": "trigger",
      },
      {
        "name": "sidebar_workspace_insert",
        "sql": "CREATE TRIGGER sidebar_workspace_insert AFTER INSERT ON workspace_registry BEGIN UPDATE session_workspaces SET sidebar_group = CASE WHEN NEW.listed = 1 THEN NEW.workspace_id ELSE 'unassigned' END WHERE cwd = NEW.path; END",
        "tbl_name": "workspace_registry",
        "type": "trigger",
      },
      {
        "name": "sidebar_workspace_update",
        "sql": "CREATE TRIGGER sidebar_workspace_update AFTER UPDATE ON workspace_registry WHEN OLD.path IS NOT NEW.path OR OLD.workspace_id IS NOT NEW.workspace_id OR OLD.listed IS NOT NEW.listed BEGIN UPDATE session_workspaces SET sidebar_group = COALESCE(
      (SELECT workspace_id FROM workspace_registry WHERE path = cwd AND listed = 1), 'unassigned') WHERE cwd IN (OLD.path, NEW.path); END",
        "tbl_name": "workspace_registry",
        "type": "trigger",
      },
    ],
    "version": 0,
  },
