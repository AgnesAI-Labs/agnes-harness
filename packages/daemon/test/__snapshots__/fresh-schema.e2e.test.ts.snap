  )",
        "tbl_name": "schedules",
        "type": "table",
      },
      {
        "name": "session_preferences",
        "sql": "CREATE TABLE session_preferences (
      session_key TEXT PRIMARY KEY, title TEXT, archived INTEGER NOT NULL DEFAULT 0, pinned_at INTEGER,
      bookmarks TEXT
    )",
        "tbl_name": "session_preferences",
        "type": "table",
      },
      {
        "name": "session_principal_ownership",
        "sql": "CREATE TABLE session_principal_ownership (
          session_id TEXT PRIMARY KEY,
          principal_id TEXT NOT NULL,
          reservation_kind TEXT NOT NULL,
