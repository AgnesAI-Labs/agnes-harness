{
  "name": "@agnes/base",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./search": "./extensions/tools-web/src/search/index.ts",
    "./computer-use": "./extensions/computer-use/src/index.ts",
    "./privacy": "./extensions/privacy/src/redact.ts",
    "./child-engines": "./extensions/subagent-sdk/src/document.ts",
    "./testkit": "./testkit/index.ts",
    "./presets/*": "./presets/*"
  },
  "agnes": {
    "plugins": [
      {
        "export": "toolPolicyPlugin",
        "apiRange": "^1.4.0",
        "id": "tool-policy:default",
        "inject": [
          "toolPolicies"
        ],
        "runtime": "in-process"
      },
      {
        "export": "approvalPlugin",
        "apiRange": "^1.4.0",
        "id": "seam:approval"
      },
      {
        "export": "principalsPlugin",
        "apiRange": "^1.4.0",
        "id": "seam:principals"
      },
      {
        "export": "artifactsPlugin",
        "apiRange": "^1.4.0",
        "id": "seam:artifacts"
      },
      {
        "export": "checkpointPlugin",
        "apiRange": "^1.4.0",
        "id": "seam:checkpoint"
      },
      {
        "export": "ledgerPlugin",
        "apiRange": "^1.4.0",
        "id": "seam:ledger"
      },
      {
        "export": "verifierPlugin",
        "apiRange": "^1.4.0",
        "id": "seam:verifier"
      },
      {
        "export": "repairPlugin",
        "apiRange": "^1.4.0",
        "id": "seam:repair"
      },
      {
        "export": "harnessPlugin",
        "apiRange": "^1.4.0",
        "id": "seam:harness"
      },
      {
        "export": "defaultLoopPlugin",
        "id": "loop:agnes.default",
        "inject": [
          "loops"
        ],
        "runtime": "in-process",
        "default": true,
        "apiRange": "^1.4.0"
      }
    ],
    "extensions": [
      "./extensions/tools-core",
      "./extensions/plugin-creator",
      "./extensions/tools-search",
      "./extensions/tools-web",
      "./extensions/compaction",
      "./extensions/refine",
      "./extensions/subagent",
      "./extensions/mcp-search",
      "./extensions/hooks-runner",
      "./extensions/privacy",
      "./extensions/skills",
      "./extensions/computer-use",
      "./extensions/interaction",
      "./extensions/goal",
      "./extensions/deliverables",
      "./extensions/jobs",
      "./extensions/plan-mode",
      "./extensions/mcp-resources",
      "./extensions/workflow",
      "./extensions/session-query",
      "./extensions/jobs-web",
      "./extensions/context-rules",
      "./extensions/time-context"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build:isolation-runner": "tsx tools/build-isolation-runner.ts",
    "gen": "tsx tools/gen-schemas.ts --write",
    "gen:check": "tsx tools/gen-schemas.ts"
  },
  "peerDependencies": {
    "@agnes/extension-api": "workspace:*"
  },
  "dependencies": {
    "@agnes/core": "workspace:*",
    "@agnes/history-index": "workspace:*",
    "@agnes/plugin-runtime": "workspace:*",
    "@agnes/protocol": "workspace:*",
    "@agnes/protocol-validation": "workspace:*",
    "@agnes/system-node": "workspace:*",
    "@joplin/turndown-plugin-gfm": "1.0.67",
    "@modelcontextprotocol/sdk": "1.25.2",
    "@sinclair/typebox": "0.34.33",
    "@vscode/ripgrep": "1.18.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "isomorphic-git": "1.41.9",
    "jiti": "2.7.0",
    "turndown": "7.2.4",
    "yaml": "2.9.0",
    "@agnes/loop-default": "workspace:*"
  },
  "devDependencies": {
    "@agnes/extension-api": "workspace:*",
    "@agnes/mcp-transport-health": "workspace:*",
    "@types/turndown": "5.0.6",
    "esbuild": "0.28.2"
  },
  "license": "Apache-2.0 AND MIT"
}
