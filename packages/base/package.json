{
  "name": "@agnes/base",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./search": "./extensions/tools-web/src/search/index.ts",
    "./computer-use": "./extensions/computer-use/src/index.ts",
    "./schedule": "./extensions/schedule/src/runtime.ts",
    "./approval-policy": "./extensions/approval-policy/src/settings.ts",
    "./testkit": "./testkit/index.ts",
    "./presets/*": "./presets/*",
    "./plan-mode": "./extensions/plan-mode/src/state.ts",
    "./sandbox": "./extensions/sandbox/src/backends.ts",
    "./plugin-creator": "./extensions/plugin-creator/src/candidate-templates.ts",
    "./provided-contracts": "./src/provided-contracts.ts"
  },
  "agnes": {
    "plugins": [
      {
        "export": "toolPolicyPlugin",
        "apiRange": "^5.0.0",
        "id": "tool-policy:default",
        "inject": [
          "providers",
          "planMode"
        ],
        "runtime": "in-process",
        "metadata": {
          "displayName": "Approval rules",
          "summary": "Decides which tool actions need approval under the selected session policy.",
          "description": "Decides which tool actions need approval under the selected session policy.",
          "locales": {
            "zh-CN": {
              "displayName": "审批规则",
              "summary": "按会话策略判断哪些工具操作需要先获得批准。",
              "description": "按会话策略判断哪些工具操作需要先获得批准。"
            }
          }
        },
        "optionalInject": [
          "planMode"
        ]
      },
      {
        "id": "observability:otel",
        "export": "observabilityPlugin",
        "inject": [
          "providers"
        ],
        "runtime": "in-process",
        "default": true,
        "apiRange": "^5.0.0",
        "configReload": "next-session",
        "configSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Enable OpenTelemetry export."
            },
            "endpoint": {
              "type": "string",
              "format": "uri",
              "description": "OTLP collector URL."
            },
            "tracesEndpoint": {
              "type": "string",
              "format": "uri"
            },
            "metricsEndpoint": {
              "type": "string",
              "format": "uri"
            },
            "batchMs": {
              "type": "integer",
              "minimum": 10,
              "maximum": 30000,
              "default": 1000
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 10,
              "maximum": 30000,
              "default": 3000
            },
            "logsEndpoint": {
              "type": "string",
              "format": "uri"
            },
            "redaction": {
              "enum": [
                "metadata",
                "content"
              ],
              "default": "metadata",
              "description": "Choose metadata-only or content telemetry."
            },
            "batchSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            },
            "queueSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384,
              "default": 1024
            },
            "shutdownPolicy": {
              "enum": [
                "flush",
                "discard"
              ],
              "default": "flush"
            },
            "headers": {
              "type": "object",
              "maxProperties": 16,
              "description": "OTLP headers use environment secret references; header values are never stored here.",
              "propertyNames": {
                "pattern": "^[a-zA-Z0-9-]{1,128}$",
                "not": {
                  "enum": [
                    "content-type",
                    "host",
                    "content-length"
                  ]
                }
              },
              "additionalProperties": {
                "type": "object",
                "required": [
                  "secretRef"
                ],
                "additionalProperties": false,
                "properties": {
                  "secretRef": {
                    "type": "string",
                    "pattern": "^env:[A-Z_][A-Z0-9_]{0,123}$",
                    "description": "Environment secret reference, for example env:OTLP_TOKEN."
                  }
                }
              }
            }
          }
        },
        "metadata": {
          "displayName": "Task telemetry",
          "summary": "Exports configured task telemetry to help operators diagnose execution and usage.",
          "description": "Exports configured task telemetry to help operators diagnose execution and usage.",
          "locales": {
            "zh-CN": {
              "displayName": "任务遥测",
              "summary": "导出已配置的任务遥测，帮助运维人员诊断执行与用量。",
              "description": "导出已配置的任务遥测，帮助运维人员诊断执行与用量。"
            }
          }
        }
      },
      {
        "export": "seamProvidersPlugin",
        "apiRange": "^5.0.0",
        "id": "seam-providers:default",
        "inject": [
          "providers"
        ],
        "runtime": "in-process",
        "metadata": {
          "displayName": "Core runtime services",
          "summary": "Provides the default approval prompts, identity, usage accounting, checkpoints, artifact storage and progress checks.",
          "description": "Provides the default approval prompts, identity, usage accounting, checkpoints, artifact storage and progress checks.",
          "locales": {
            "zh-CN": {
              "displayName": "核心运行服务",
              "summary": "提供默认的审批提示、身份、用量记录、文件检查点、产物存储和进度检查。",
              "description": "提供默认的审批提示、身份、用量记录、文件检查点、产物存储和进度检查。"
            }
          }
        }
      },
      {
        "export": "defaultLoopPlugin",
        "id": "loop:agnes.default",
        "inject": [
          "providers"
        ],
        "runtime": "in-process",
        "default": true,
        "apiRange": "^5.0.0",
        "metadata": {
          "displayName": "Default Agent Loop",
          "summary": "Runs the default agent workflow through model calls, tools, approvals and continuation.",
          "description": "Runs the default agent workflow through model calls, tools, approvals and continuation.",
          "locales": {
            "zh-CN": {
              "displayName": "默认 Agent Loop",
              "summary": "通过模型调用、工具、审批与续接执行默认 Agent 工作流。",
              "description": "通过模型调用、工具、审批与续接执行默认 Agent 工作流。"
            }
          }
        }
      },
      {
        "export": "codexChildAgentsPlugin",
        "id": "child-agent:codex",
        "inject": [
          "providers"
        ],
        "runtime": "in-process",
        "default": false,
        "apiRange": "^5.0.0",
        "metadata": {
          "displayName": "Codex child agents",
          "summary": "Uses a configured Codex process to handle delegated coding tasks.",
          "description": "Uses a configured Codex process to handle delegated coding tasks.",
          "locales": {
            "zh-CN": {
              "displayName": "Codex 子 Agent",
              "summary": "使用已配置的 Codex 进程处理分派的编程任务。",
              "description": "使用已配置的 Codex 进程处理分派的编程任务。"
            }
          }
        }
      },
      {
        "export": "claudeCodeChildAgentsPlugin",
        "id": "child-agent:claude-code",
        "inject": [
          "providers"
        ],
        "runtime": "in-process",
        "default": false,
        "apiRange": "^5.0.0",
        "metadata": {
          "displayName": "Claude Code child agents",
          "summary": "Uses a configured Claude Code process to handle delegated coding tasks.",
          "description": "Uses a configured Claude Code process to handle delegated coding tasks.",
          "locales": {
            "zh-CN": {
              "displayName": "Claude Code 子 Agent",
              "summary": "使用已配置的 Claude Code 进程处理分派的编程任务。",
              "description": "使用已配置的 Claude Code 进程处理分派的编程任务。"
            }
          }
        }
      },
      {
        "export": "sdkChildAgentsPlugin",
        "id": "child-agent:sdk",
        "inject": [
          "providers"
        ],
        "runtime": "in-process",
        "default": false,
        "apiRange": "^5.0.0",
        "metadata": {
          "displayName": "Built-in child agents",
          "summary": "Runs delegated tasks in child sessions through AGH's built-in agent engine.",
          "description": "Runs delegated tasks in child sessions through AGH's built-in agent engine.",
          "locales": {
            "zh-CN": {
              "displayName": "内置子 Agent",
              "summary": "通过 AGH 内置 Agent 引擎，在子会话中执行分派的任务。",
              "description": "通过 AGH 内置 Agent 引擎，在子会话中执行分派的任务。"
            }
          }
        }
      },
      {
        "id": "memory:file",
        "export": "memoryPlugin",
        "inject": [
          "providers"
        ],
        "runtime": "in-process",
        "default": true,
        "apiRange": "^5.0.0",
        "metadata": {
          "displayName": "Workspace memory",
          "summary": "Keeps reviewed workspace preferences in local files for later sessions, with agent access off by default.",
          "description": "Keeps reviewed workspace preferences in local files for later sessions, with agent access off by default.",
          "locales": {
            "zh-CN": {
              "displayName": "工作区记忆",
              "summary": "在本地文件中保留经审核的工作区偏好供后续会话使用，默认关闭 Agent 访问。",
              "description": "在本地文件中保留经审核的工作区偏好供后续会话使用，默认关闭 Agent 访问。"
            }
          }
        }
      },
      {
        "id": "skills:remembering",
        "export": "rememberingPlugin",
        "inject": [
          "skills"
        ],
        "runtime": "in-process",
        "default": true,
        "apiRange": "^5.0.0",
        "metadata": {
          "displayName": "Remembering playbook",
          "summary": "Supplies a reusable playbook for reviewing and recording workspace preferences.",
          "description": "Supplies a reusable playbook for reviewing and recording workspace preferences.",
          "locales": {
            "zh-CN": {
              "displayName": "偏好记忆手册",
              "summary": "提供用于审核和记录工作区偏好的可复用操作手册。",
              "description": "提供用于审核和记录工作区偏好的可复用操作手册。"
            }
          }
        }
      },
      {
        "id": "reference-resolvers:default",
        "export": "referenceResolversPlugin",
        "inject": [
          "providers"
        ],
        "runtime": "in-process",
        "default": true,
        "apiRange": "^5.0.0",
        "metadata": {
          "displayName": "Conversation references",
          "summary": "Resolves supported file and session references attached to a conversation.",
          "description": "Resolves supported file and session references attached to a conversation.",
          "locales": {
            "zh-CN": {
              "displayName": "对话引用",
              "summary": "解析对话中附带的受支持文件与会话引用。",
              "description": "解析对话中附带的受支持文件与会话引用。"
            }
          }
        }
      },
      {
        "id": "service:plan-mode",
        "export": "planModePlugin",
        "apiRange": "^5.0.0",
        "inject": [
          "providers",
          "services"
        ],
        "metadata": {
          "displayName": "Plan mode controls",
          "summary": "Provides shared plan mode controls for Web and terminal clients.",
          "description": "Provides shared plan mode controls for Web and terminal clients.",
          "locales": {
            "zh-CN": {
              "displayName": "计划模式控制",
              "summary": "为 Web 和终端客户端提供共享的计划模式控制。",
              "description": "为 Web 和终端客户端提供共享的计划模式控制。"
            }
          }
        },
        "provide": [
          "planMode"
        ],
        "capabilities": {
          "services": [
            {
              "name": "plan.status",
              "kind": "query",
              "inputSchema": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
              },
              "outputSchema": {
                "type": "object",
                "additionalProperties": true
              },
              "timeoutMs": 10000,
              "maxResultBytes": 1048576
            },
            {
              "name": "plan.command",
              "kind": "effect",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "line": {
                    "type": "string",
                    "maxLength": 8192,
                    "pattern": "^\\s*/plan(?:\\s|$)"
                  }
                },
                "required": [
                  "line"
                ],
                "additionalProperties": false
              },
              "outputSchema": {
                "type": "object",
                "additionalProperties": true
              },
              "timeoutMs": 10000,
              "maxResultBytes": 1048576
            }
          ]
        }
      }
    ],
    "extensions": [
      "./extensions/tools-core",
      "./extensions/plugin-creator",
      "./extensions/tools-search",
      "./extensions/tools-web",
      "./extensions/compaction",
      "./extensions/refine",
      "./extensions/subagent",
      "./extensions/mcp-search",
      "./extensions/hooks-runner",
      "./extensions/privacy",
      "./extensions/skills",
      "./extensions/computer-use",
      "./extensions/interaction",
      "./extensions/goal",
      "./extensions/deliverables",
      "./extensions/jobs",
      "./extensions/plan-mode",
      "./extensions/mcp-resources",
      "./extensions/workflow",
      "./extensions/session-query",
      "./extensions/jobs-web",
      "./extensions/context-rules",
      "./extensions/time-context",
      "./extensions/follow-up-hint",
      "./extensions/heads-up",
      "./extensions/schedule",
      "./extensions/intelligent-ui",
      "./extensions/lsp"
    ],
    "metadata": {
      "displayName": "AGH essentials",
      "summary": "Supplies the default tools and runtime services used by AGH agents.",
      "description": "Supplies the default tools and runtime services used by AGH agents.",
      "locales": {
        "zh-CN": {
          "displayName": "AGH 基础能力",
          "summary": "提供 AGH Agent 使用的默认工具与运行时服务。",
          "description": "提供 AGH Agent 使用的默认工具与运行时服务。"
        }
      }
    },
    "provides": [
      "service"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build:isolation-runner": "tsx tools/build-isolation-runner.ts",
    "gen": "tsx tools/gen-schemas.ts --write && node tools/gen-memory-assets.mjs --write",
    "gen:check": "tsx tools/gen-schemas.ts && node tools/gen-memory-assets.mjs"
  },
  "peerDependencies": {
    "@agnes/extension-api": "workspace:*"
  },
  "dependencies": {
    "@agnes/core": "workspace:*",
    "@agnes/core-common": "workspace:*",
    "@agnes/history-index": "workspace:*",
    "@agnes/git-worktree-contract": "workspace:*",
    "@agnes/intelligent-ui-contract": "workspace:*",
    "@agnes/loop-default": "workspace:*",
    "@agnes/observability": "workspace:*",
    "@agnes/plugin-runtime": "workspace:*",
    "@agnes/protocol": "workspace:*",
    "@agnes/protocol-validation": "workspace:*",
    "@agnes/system-node": "workspace:*",
    "@joplin/turndown-plugin-gfm": "1.0.67",
    "@modelcontextprotocol/sdk": "1.25.2",
    "@sinclair/typebox": "0.34.33",
    "@vscode/ripgrep": "1.18.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "isomorphic-git": "1.41.9",
    "jiti": "2.7.0",
    "sharp": "0.34.5",
    "turndown": "7.2.4",
    "yaml": "2.9.0",
    "@agnes/memory-file": "workspace:*",
    "@agnes/error-sanitization": "workspace:*"
  },
  "devDependencies": {
    "@agnes/core-effects": "workspace:*",
    "@agnes/extension-api": "workspace:*",
    "@types/turndown": "5.0.6",
    "esbuild": "0.28.2"
  },
  "license": "Apache-2.0 AND MIT"
}
