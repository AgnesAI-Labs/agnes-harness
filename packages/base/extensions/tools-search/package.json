{
  "name": "@agnes/tools-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "agnes": {
    "plugins": [
      {
        "id": "ext:agnes/tools-search",
        "export": "default",
        "apiRange": "^5.0.0",
        "inject": [
          "tools"
        ],
        "capabilities": {
          "tools": {
            "prefix": "",
            "names": [
              "grep",
              "find",
              "ls"
            ]
          },
          "hooks": [],
          "slots": [],
          "events": false,
          "resources": [],
          "network": [],
          "artifacts": true
        },
        "metadata": {
          "displayName": "Project file search",
          "summary": "Lets the agent find project files and search their contents.",
          "description": "Lets the agent find project files and search their contents.",
          "locales": {
            "zh-CN": {
              "displayName": "项目文件搜索",
              "summary": "让 Agent 查找项目文件并检索文件内容。",
              "description": "让 Agent 查找项目文件并检索文件内容。"
            }
          }
        }
      }
    ],
    "provides": [
      "tool"
    ]
  }
}
