{
  "name": "@agnes/workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "agnes": {
    "plugins": [
      {
        "id": "ext:agnes/workflow",
        "export": "default",
        "apiRange": "^5.0.0",
        "inject": [
          "tools",
          "hooks",
          "projections",
          "eventLog"
        ],
        "capabilities": {
          "tools": {
            "prefix": "",
            "names": [
              "workflow",
              "workflow_status"
            ]
          },
          "hooks": [
            "context"
          ],
          "slots": [],
          "projections": [
            {
              "name": "runs",
              "inputEventTypes": [
                "x/agnes/workflow/run",
                "x/agnes/workflow/view"
              ],
              "maxStateBytes": 262144
            }
          ],
          "events": true,
          "resources": [],
          "network": [],
          "tools.invoke": true,
          "subagent": true
        },
        "metadata": {
          "displayName": "Coordinated workflows",
          "summary": "Lets the agent run multi-step tool and child-agent workflows and inspect their progress.",
          "description": "Lets the agent run multi-step tool and child-agent workflows and inspect their progress.",
          "locales": {
            "zh-CN": {
              "displayName": "协同工作流",
              "summary": "让 Agent 执行由工具和子 Agent 组成的多步骤工作流，并查看进度。",
              "description": "让 Agent 执行由工具和子 Agent 组成的多步骤工作流，并查看进度。"
            }
          }
        }
      }
    ],
    "provides": [
      "tool"
    ]
  }
}
