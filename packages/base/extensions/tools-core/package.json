{
  "name": "@agnes/tools-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "agnes": {
    "plugins": [
      {
        "id": "ext:agnes/tools-core",
        "export": "default",
        "apiRange": "^5.0.0",
        "inject": [
          "tools",
          "hooks",
          "eventLog"
        ],
        "capabilities": {
          "tools": {
            "prefix": "",
            "names": [
              "read",
              "write",
              "edit",
              "shell",
              "todo"
            ]
          },
          "hooks": [
            "shutdown"
          ],
          "slots": [],
          "events": true,
          "resources": [],
          "network": [],
          "artifacts": true
        },
        "metadata": {
          "displayName": "Files and commands",
          "summary": "Lets the agent read and edit files, run shell commands and maintain a task list.",
          "description": "Lets the agent read and edit files, run shell commands and maintain a task list.",
          "locales": {
            "zh-CN": {
              "displayName": "文件与命令",
              "summary": "让 Agent 读写文件、执行 shell 命令并维护任务清单。",
              "description": "让 Agent 读写文件、执行 shell 命令并维护任务清单。"
            }
          }
        }
      }
    ],
    "provides": [
      "tool"
    ]
  }
}
