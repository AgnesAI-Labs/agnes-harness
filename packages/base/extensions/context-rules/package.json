{
  "name": "@agnes/context-rules",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "agnes": {
    "plugins": [
      {
        "id": "ext:agnes/context-rules",
        "export": "default",
        "apiRange": "^5.0.0",
        "inject": [
          "hooks",
          "projections"
        ],
        "capabilities": {
          "hooks": [
            "context"
          ],
          "projections": [
            {
              "name": "scopes",
              "inputEventTypes": [
                "tool/call"
              ],
              "maxStateBytes": 65536
            }
          ]
        },
        "metadata": {
          "displayName": "Workspace instructions",
          "summary": "Includes relevant workspace instructions when the agent works with project files.",
          "description": "Includes relevant workspace instructions when the agent works with project files.",
          "locales": {
            "zh-CN": {
              "displayName": "工作区规则",
              "summary": "在 Agent 处理项目文件时带入相关工作区规则。",
              "description": "在 Agent 处理项目文件时带入相关工作区规则。"
            }
          }
        }
      }
    ]
  }
}
