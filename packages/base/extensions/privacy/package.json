{
  "name": "@agnes/privacy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "agnes": {
    "plugins": [
      {
        "id": "ext:agnes/privacy",
        "export": "default",
        "apiRange": "^5.0.0",
        "inject": [
          "hooks",
          "eventLog"
        ],
        "capabilities": {
          "hooks": [
            "session_start",
            "shutdown"
          ],
