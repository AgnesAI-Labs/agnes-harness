{
  "name": "@agnes/refine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "agnes": {
    "plugins": [
      {
        "id": "ext:agnes/refine",
        "export": "default",
        "apiRange": "^5.0.0",
        "inject": [
          "tools",
          "hooks",
          "eventLog"
        ],
        "capabilities": {
          "tools": {
            "prefix": "",
            "names": [
              "harness_propose"
            ]
          },
          "hooks": [
            "compact"
