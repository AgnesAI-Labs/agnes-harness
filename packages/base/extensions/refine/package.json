          "summary": "Lets the agent propose evidence-backed changes to prompts, memory, Skills and child-agent definitions.",
          "description": "Lets the agent propose evidence-backed changes to prompts, memory, Skills and child-agent definitions.",
          "locales": {
            "zh-CN": {
              "displayName": "改进提案",
