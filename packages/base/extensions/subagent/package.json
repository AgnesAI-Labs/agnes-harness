{
  "name": "@agnes/subagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "agnes": {
    "plugins": [
      {
        "id": "ext:agnes/subagent",
        "export": "default",
        "apiRange": "^5.0.0",
        "inject": [
          "tools"
        ],
        "capabilities": {
          "tools": {
            "prefix": "",
            "names": [
              "subagent_fork",
              "subagent_spawn",
              "subagent_collect",
              "subagent_cancel",
              "subagent_list",
              "subagent_send_message",
              "subagent_interrupt",
              "list_subagent_models"
            ]
          },
          "hooks": [],
          "slots": [],
          "events": true,
          "subagent": true,
          "resources": [],
          "network": []
        },
        "metadata": {
          "displayName": "Child-agent coordination",
          "summary": "Lets the agent delegate work to child agents, exchange messages and collect their results.",
          "description": "Lets the agent delegate work to child agents, exchange messages and collect their results.",
          "locales": {
            "zh-CN": {
              "displayName": "子 Agent 协作",
              "summary": "让 Agent 分派子任务、与子 Agent 交换消息并收集结果。",
              "description": "让 Agent 分派子任务、与子 Agent 交换消息并收集结果。"
            }
          }
        }
      }
    ],
    "provides": [
      "tool"
    ]
  }
}
