{
  "name": "@agnes/session-query",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "agnes": {
    "plugins": [
      {
        "id": "ext:agnes/session-query",
        "export": "default",
        "apiRange": "^5.0.0",
        "inject": [
          "tools",
          "hooks",
          "self"
        ],
        "capabilities": {
          "tools": {
            "prefix": "",
            "names": [
              "session_search",
              "session_event_search",
              "session_trace",
              "session_event_trace",
              "session_event_read"
            ]
          },
          "hooks": [
            "context"
          ],
          "slots": [],
          "events": false,
          "resources": [],
          "network": []
        },
        "metadata": {
          "displayName": "Session history search",
          "summary": "Lets the agent search readable session history and inspect the events behind a result.",
          "description": "Lets the agent search readable session history and inspect the events behind a result.",
          "locales": {
            "zh-CN": {
              "displayName": "会话历史检索",
              "summary": "让 Agent 检索有权读取的会话历史，并查看结果对应的事件。",
              "description": "让 Agent 检索有权读取的会话历史，并查看结果对应的事件。"
            }
          }
        }
      }
    ],
    "provides": [
      "tool"
    ]
  }
}
