{
  "id": "agnes/interaction",
  "version": "0.1.0",
  "apiRange": "^1.4",
  "entry": "./src/index.ts",
  "capabilities": {
    "tools": {
      "prefix": "",
      "names": ["ask_user_question"]
    },
    "hooks": ["before_step", "tool_call"],
    "events": true,
    "slots": ["tool.card.inline"],
    "projections": [
      {
        "name": "questions",
        "inputEventTypes": ["x/agnes/interaction/requested", "user/message"],
        "maxStateBytes": 262144
      }
    ]
  }
}
