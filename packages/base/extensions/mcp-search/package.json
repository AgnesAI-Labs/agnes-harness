{
  "name": "@agnes/mcp-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "agnes": {
    "plugins": [
      {
        "id": "ext:agnes/mcp-search",
        "export": "default",
        "apiRange": "^5.0.0",
        "inject": [
          "tools"
        ],
        "capabilities": {
          "tools": {
            "prefix": "tool_",
            "names": [
              "tool_search",
              "tool_describe"
            ]
          },
          "hooks": [],
          "slots": [],
          "events": false,
          "resources": [],
          "network": []
        },
        "metadata": {
          "displayName": "Tool discovery",
          "summary": "Helps the agent find connected MCP tools and inspect their inputs before use.",
          "description": "Helps the agent find connected MCP tools and inspect their inputs before use.",
          "locales": {
            "zh-CN": {
              "displayName": "工具发现",
              "summary": "帮助 Agent 找到已连接的 MCP 工具，并在使用前查看输入要求。",
              "description": "帮助 Agent 找到已连接的 MCP 工具，并在使用前查看输入要求。"
            }
          }
        }
      }
    ],
    "provides": [
      "tool"
    ]
  }
}
