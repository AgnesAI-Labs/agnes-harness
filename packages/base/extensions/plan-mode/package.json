{
  "name": "@agnes/plan-mode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "agnes": {
    "plugins": [
      {
        "id": "ext:agnes/plan-mode",
        "export": "default",
        "apiRange": "^5.0.0",
        "inject": [
          "tools",
          "hooks",
          "providers",
          "self"
        ],
        "capabilities": {
          "tools": {
            "prefix": "",
            "names": [
              "exit_plan_mode"
            ]
          },
          "hooks": [
            "context",
            "approval_request"
          ],
          "slots": [],
