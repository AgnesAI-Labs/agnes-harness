{
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "command": {
      "minLength": 1,
      "type": "string"
    },
    "timeoutMs": {
      "minimum": 1,
      "type": "integer"
    },
    "cwd": {
      "minLength": 1,
      "maxLength": 4096,
      "type": "string"
    },
    "background": {
      "type": "boolean"
    },
    "timeoutToBackground": {
      "type": "boolean"
    },
    "persistent": {
      "type": "boolean"
    },
    "shell": {
      "anyOf": [
        {
          "const": "bash",
          "type": "string"
        },
        {
          "const": "zsh",
          "type": "string"
        },
        {
          "const": "pwsh",
          "type": "string"
        }
      ]
    },
    "sessionId": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "command"
  ]
}
