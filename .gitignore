.superpowers/
node_modules/
dist/
*.tsbuildinfo
packages/package-manager/bundled-plugins/document-reader/src/runtime/
.agnes-tmp/

# A literal tilde directory: host defaults dataDir to the string "~/.agnes" and nothing
# expands it, so a run without an explicit dataDir writes here. Ignored so it cannot be
# committed again; the defect itself is being fixed in host.
~/
.agnes-scratch/

# Compiled at build time by packages/host/scripts/build-native.mjs (macOS only). Host helpers
# live in its ignored dist/ tree; C sources remain in packages/host/native/.
packages/host/native/macos-process-identity
packages/host/native/macos-live-app-identity

# Subagent worktrees live inside the repository; the fail-closed manager verifies this rule before
# creating one so the parent checkout cannot accidentally stage a nested worktree.
.worktrees/
.codegraph/

# Machine-local IDE settings and temporary Windows test output.
.idea/
/.windows-core-host-check.log
.agnes
.agh
learn/
.DS_Store

# Local assistant configuration and unpublished scratch material.
.claude/
.cursor/
outputs/
spikes/
docs/task-records/

# Playwright MCP writes page snapshots, console logs and screenshots here while it runs.
.playwright-mcp/

# Generated from packages/loop-jev by `pnpm --filter @agnes/package-manager build:jev-payload`.
packages/package-manager/bundled-plugins/jev-loop/index.mjs
packages/package-manager/bundled-plugins/jev-loop/index.mjs.*.tmp

# Deterministic presentation build records
packages/package-manager/bundled-plugins/*/client-build.json

# Presentation clients and their dependency notices are build outputs, not source.
packages/package-manager/bundled-plugins/conversation-ui/src/client.js
packages/package-manager/bundled-plugins/conversation-ui/NOTICE
packages/package-manager/bundled-plugins/navigation-ui/src/client.js
packages/package-manager/bundled-plugins/navigation-ui/NOTICE
packages/package-manager/bundled-plugins/interaction-ui/src/client.js
packages/package-manager/bundled-plugins/interaction-ui/NOTICE
packages/package-manager/bundled-plugins/goal-ui/src/client.js
packages/package-manager/bundled-plugins/goal-ui/NOTICE
packages/package-manager/bundled-plugins/deliverables-ui/src/client.js
packages/package-manager/bundled-plugins/deliverables-ui/NOTICE

packages/package-manager/bundled-plugins/browser/src/client.js
packages/package-manager/bundled-plugins/browser/NOTICE

# DevBoard live projects written into the session workspace during manual demos
/devboard-projects/
