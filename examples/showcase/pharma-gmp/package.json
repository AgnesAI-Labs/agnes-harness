{
  "name": "@agnes-showcase/pharma-gmp",
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.10"
  },
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "client",
    "assets",
    "skills",
    "README.md",
    "README.zh-CN.md",
    "DEMO.md",
    "DOMAIN-NOTES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "test": "vitest run examples/showcase/pharma-gmp/test --project fast --maxWorkers=1"
  },
  "dependencies": {
    "@agnes/extension-api": "workspace:*",
    "@agnes/plugin-runtime": "workspace:*",
    "@sinclair/typebox": "0.34.33"
  },
  "devDependencies": {
    "@agnes/host": "workspace:*",
    "@agnes/sdk": "workspace:*",
    "@agnes/web-client": "workspace:*",
    "@agnes/web-ui": "workspace:*",
    "@agnes/package-manager": "workspace:*",
    "@agnes/protocol": "workspace:*",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "react-dom": "18.3.1",
    "@agnes/resource-control-runtime": "workspace:*"
  },
  "peerDependencies": {
    "react": "18.3.1"
  },
  "agnes": {
    "provides": [
      "tool",
      "ui",
      "bundle",
      "skills",
      "service"
    ],
    "plugins": [
      {
        "id": "ext:@agnes-showcase/pharma-gmp/main",
        "export": "main",
        "apiRange": "^4.0.0",
        "inject": [
          "tools",
          "services",
          "skills",
          "providers"
        ],
        "capabilities": {
          "ui": true,
          "store": true,
          "filesystem": {
            "read": [
              "pharma-output/**"
            ],
            "write": [
              "pharma-output/**"
            ]
          },
          "tools": {
            "names": [
              "pharma_inspect",
              "pharma_dossier",
              "pharma_record",
              "pharma_release",
              "pharma_report"
            ],
            "prefix": "pharma_"
          },
          "tools.invoke": true
        }
      },
      {
        "id": "ext:@agnes-showcase/pharma-gmp/cards",
        "export": "cards",
        "apiRange": "^4.0.0",
        "capabilities": {
          "ui": true
        }
      }
    ],
    "hostProvidedExternals": {
      "@agnes/extension-api": "^4.0.0",
      "@agnes/plugin-runtime": "0.0.0",
      "@sinclair/typebox": "~0.34.0"
    },
    "clientDescriptors": [
      {
        "rowId": "ext:@agnes-showcase/pharma-gmp/main",
        "path": "./client/agnes.client.json"
      },
      {
        "rowId": "ext:@agnes-showcase/pharma-gmp/cards",
        "path": "./client/evidence/agnes.client.json"
      }
    ],
    "bundles": {
      "hub": {
        "profile": {
          "tools": [
            "pharma_inspect",
            "pharma_dossier",
            "pharma_report",
            "present",
            "ask_user_question",
            "read",
            "ui_render",
            "skill_read",
            "pharma_record",
            "pharma_release",
            "schedule_create",
            "schedule_list",
            "schedule_update",
            "schedule_delete",
            "plugin_helper_create",
            "plugin_helper_install",
            "plugin_helper_guide",
            "plugin_candidate_read",
            "plugin_candidate_write"
          ],
          "skills": [
            "gmp-review"
          ],
          "toolPolicy": {
            "allow": [
              "pharma_inspect",
              "pharma_dossier",
              "pharma_report",
              "present",
              "ask_user_question",
              "read",
              "ui_render",
              "skill_read",
              "pharma_record",
              "pharma_release",
              "schedule_create",
              "schedule_list",
              "schedule_update",
              "schedule_delete",
              "plugin_helper_create",
              "plugin_helper_install",
              "plugin_helper_guide",
              "plugin_candidate_read",
              "plugin_candidate_write"
            ]
          }
        },
        "presets": {
          "gmp": {
            "name": "gmp",
            "extends": "standard",
            "providers": {
              "tool-policy": {
                "provider": "sableleaf-quality"
              }
            }
          }
        },
        "launch": {
          "title": {
            "en": "Quality Hub Assistant",
            "zh-CN": "质量中枢助手"
          },
          "description": {
            "en": "Inspect B-2410-017 and route review, investigation, EM and release work with tool evidence.",
            "zh-CN": "先读取批次 B-2410-017 并说明该由哪个角色协作，所有结论引用工具证据。"
          },
          "preset": "gmp",
          "pages": [
            "pharma-home"
          ],
          "prompt": {
            "mode": "draft",
            "text": {
              "en": "Inspect B-2410-017 and route review, investigation, EM and release work with tool evidence.",
