{
  "name": "@agnes-showcase/pharma-gmp",
  "version": "1.2.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.10"
  },
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "client",
    "assets",
    "skills",
    "README.md",
    "README.zh-CN.md",
    "DEMO.md",
    "DOMAIN-NOTES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "test": "vitest run examples/showcase/pharma-gmp/test --project fast --maxWorkers=1"
  },
  "dependencies": {
    "@agnes/extension-api": "workspace:*",
    "@agnes/plugin-runtime": "workspace:*",
    "@sinclair/typebox": "0.34.33"
  },
  "devDependencies": {
    "@agnes/host": "workspace:*",
    "@agnes/sdk": "workspace:*",
    "@agnes/web-client": "workspace:*",
    "@agnes/web-ui": "workspace:*",
    "@agnes/package-manager": "workspace:*",
    "@agnes/protocol": "workspace:*",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "react-dom": "18.3.1",
    "@agnes/resource-control-runtime": "workspace:*",
    "@agnes/host-extensions": "workspace:*",
    "@agnes/host-infrastructure": "workspace:*"
  },
  "peerDependencies": {
    "react": "18.3.1"
  },
  "agnes": {
    "provides": [
      "tool",
      "ui",
      "bundle",
      "skills",
      "service"
    ],
    "plugins": [
      {
        "id": "ext:@agnes-showcase/pharma-gmp/main",
        "export": "main",
        "apiRange": "^4.0.0",
        "inject": [
          "tools",
          "services",
          "skills",
          "providers"
        ],
        "capabilities": {
          "ui": true,
          "store": true,
          "filesystem": {
            "read": [
              "pharma-output/**"
            ],
            "write": [
              "pharma-output/**"
            ]
          },
          "tools": {
            "names": [
              "pharma_inspect",
              "pharma_dossier",
              "pharma_record",
              "pharma_release",
              "pharma_report"
            ],
            "prefix": "pharma_"
          },
          "tools.invoke": true
        }
      },
      {
        "id": "ext:@agnes-showcase/pharma-gmp/cards",
        "export": "cards",
        "apiRange": "^4.0.0",
        "capabilities": {
          "ui": true
        }
      }
    ],
    "hostProvidedExternals": {
      "@agnes/extension-api": "^4.0.0",
      "@agnes/plugin-runtime": "0.0.0",
      "@sinclair/typebox": "~0.34.0"
    },
    "clientDescriptors": [
      {
        "rowId": "ext:@agnes-showcase/pharma-gmp/main",
        "path": "./client/agnes.client.json"
      },
      {
        "rowId": "ext:@agnes-showcase/pharma-gmp/cards",
        "path": "./client/evidence/agnes.client.json"
      }
    ],
    "bundles": {
      "hub": {
        "profile": {
          "tools": [
            "pharma_inspect",
            "pharma_dossier",
            "pharma_report",
            "present",
            "ask_user_question",
            "read",
            "ui_render",
            "skill_read",
            "pharma_record",
            "pharma_release",
            "schedule_create",
            "schedule_list",
            "schedule_update",
            "schedule_delete",
            "plugin_helper_create",
            "plugin_helper_install",
            "plugin_helper_guide",
            "plugin_candidate_read",
            "plugin_candidate_write",
            "subagent_spawn",
            "subagent_list"
          ],
          "skills": [
            "gmp-review"
          ],
          "toolPolicy": {
            "allow": [
              "pharma_inspect",
              "pharma_dossier",
              "pharma_report",
              "present",
              "ask_user_question",
              "read",
              "ui_render",
              "skill_read",
              "pharma_record",
              "pharma_release",
              "schedule_create",
              "schedule_list",
              "schedule_update",
              "schedule_delete",
              "plugin_helper_create",
              "plugin_helper_install",
              "plugin_helper_guide",
              "plugin_candidate_read",
              "plugin_candidate_write",
              "subagent_spawn",
              "subagent_list"
            ]
          }
        },
        "presets": {
          "gmp": {
            "name": "gmp",
            "extends": "standard",
            "providers": {
              "tool-policy": {
                "provider": "sableleaf-quality"
              }
            },
            "model": {
              "system_prompt": {
                "personaPrefix": "You are the Quality Assistant / 质量助手, the single entry for this application. Delegate investigation to @agnes-showcase/pharma-gmp#investigator, batch review to #reviewer, environmental assessment to #em and pre-release checks to #release using subagent_spawn with each full package#bundle ref and a self-contained task. End the turn after starting a child; its findings arrive automatically. Summarize the specialist findings in the user language, clearly separating evidence from hypotheses. Specialists cannot approve or sign. After findings, perform explicitly requested signed pharma_record (investigate/review/advance) and pharma_release yourself in this main conversation, reading the latest revision and requesting Host consent through the business tool. Never ask a specialist to sign or invent missing evidence. 对 DEV-2410-017 的调查先委派偏差调查员；收到结果后中文概述，用户明确要求登记时在主对话调用受控签署工具。"
              }
            }
          }
        },
        "launch": {
          "title": {
            "en": "Quality Assistant",
            "zh-CN": "质量助手"
          },
          "description": {
            "en": "Inspect B-2410-017 and route review, investigation, EM and release work with tool evidence.",
            "zh-CN": "先读取批次 B-2410-017 并说明该由哪个角色协作，所有结论引用工具证据。"
          },
          "preset": "gmp",
          "pages": [
            "pharma-home"
          ],
          "prompt": {
            "mode": "draft",
            "text": {
              "en": "Inspect B-2410-017 and route review, investigation, EM and release work with tool evidence.",
              "zh-CN": "先读取批次 B-2410-017 并说明该由哪个角色协作，所有结论引用工具证据。"
            }
          }
        }
      },
      "reviewer": {
        "profile": {
          "tools": [
            "pharma_inspect",
            "pharma_dossier",
            "pharma_report",
            "present",
            "ask_user_question",
            "read",
            "ui_render",
            "skill_read",
            "pharma_record"
          ],
          "skills": [
            "gmp-review"
          ],
          "toolPolicy": {
            "allow": [
              "pharma_inspect",
              "pharma_dossier",
              "pharma_report",
              "present",
              "ask_user_question",
              "read",
              "ui_render",
              "skill_read",
              "pharma_record"
            ]
          }
        },
        "presets": {
          "gmp": {
            "name": "gmp",
            "extends": "standard",
            "providers": {
              "tool-policy": {
                "provider": "sableleaf-quality"
              }
            },
            "model": {
              "system_prompt": {
                "personaPrefix": "You are the Batch Record Reviewer / 批记录审核员. Independently inspect the selected batch CPP/IPC, ALCOA+, original LOD, calibration and retests. Return findings, blockers and the reviewed revision in the task language. Do not write or sign; the main Quality Assistant performs signed review after summarizing your findings."
              }
            }
          }
        },
        "launch": {
          "title": {
            "en": "Batch Record Reviewer",
            "zh-CN": "批记录审核员"
          },
          "description": {
            "en": "Review B-2410-017 CPP/IPC and ALCOA+; rank findings and draft review comments using tool evidence.",
            "zh-CN": "审核 B-2410-017 的 CPP、IPC 与 ALCOA+，按严重度列出发现并草拟审核意见；先读取工具证据。"
          },
          "preset": "gmp",
          "pages": [
            "pharma-home"
          ],
          "prompt": {
            "mode": "draft",
            "text": {
              "en": "Review B-2410-017 CPP/IPC and ALCOA+; rank findings and draft review comments using tool evidence.",
              "zh-CN": "审核 B-2410-017 的 CPP、IPC 与 ALCOA+，按严重度列出发现并草拟审核意见；先读取工具证据。"
            }
          }
        }
      },
      "investigator": {
        "profile": {
          "tools": [
            "pharma_inspect",
            "pharma_dossier",
            "pharma_report",
            "present",
            "ask_user_question",
            "read",
            "ui_render",
            "skill_read",
            "pharma_record"
          ],
          "skills": [
            "gmp-review"
          ],
          "toolPolicy": {
            "allow": [
              "pharma_inspect",
              "pharma_dossier",
              "pharma_report",
              "present",
              "ask_user_question",
              "read",
              "ui_render",
              "skill_read",
              "pharma_record"
            ]
          }
        },
        "presets": {
          "gmp": {
            "name": "gmp",
            "extends": "standard",
            "providers": {
              "tool-policy": {
                "provider": "sableleaf-quality"
              }
            },
            "model": {
              "system_prompt": {
                "personaPrefix": "You are the Deviation Investigator / 偏差调查员. Inspect the selected deviation and linked batch evidence, distinguish original readings, hypotheses and confirmed root causes, and return a concise investigation and CAPA recommendation in the task language. DEV-2410-017 links to batch B-2410-017. Do not write records or sign; hand all record/advance actions back to the main Quality Assistant with the evidence and reviewed revision. Never invent real evidence."
              }
            }
          }
        },
        "launch": {
          "title": {
            "en": "Deviation Investigator",
            "zh-CN": "偏差调查员"
          },
          "description": {
            "en": "Investigate B-2410-017 drying LOD, EM and equipment; propose 5-Why, CAPA and cross-batch impact; distinguish hypotheses from facts.",
            "zh-CN": "调查 B-2410-017 的干燥 LOD、EM 和设备，提出 5-Why、CAPA 及跨批影响；区分假设与已确认事实。"
          },
          "preset": "gmp",
          "pages": [
            "pharma-home"
          ],
          "prompt": {
            "mode": "draft",
            "text": {
              "en": "Investigate B-2410-017 drying LOD, EM and equipment; propose 5-Why, CAPA and cross-batch impact; distinguish hypotheses from facts.",
              "zh-CN": "调查 B-2410-017 的干燥 LOD、EM 和设备，提出 5-Why、CAPA 及跨批影响；区分假设与已确认事实。"
            }
          }
        }
      },
      "em": {
        "profile": {
          "tools": [
            "pharma_inspect",
            "pharma_dossier",
            "pharma_report",
            "present",
            "ask_user_question",
            "read",
            "ui_render",
            "skill_read",
            "schedule_create",
            "schedule_list",
            "schedule_update",
            "schedule_delete"
          ],
          "skills": [
            "gmp-review"
          ],
          "toolPolicy": {
            "allow": [
              "pharma_inspect",
              "pharma_dossier",
              "pharma_report",
              "present",
              "ask_user_question",
              "read",
              "ui_render",
              "skill_read",
              "schedule_create",
              "schedule_list",
              "schedule_update",
              "schedule_delete"
            ]
          }
        },
        "presets": {
          "gmp": {
            "name": "gmp",
            "extends": "standard",
            "providers": {
              "tool-policy": {
                "provider": "sableleaf-quality"
              }
            },
            "model": {
              "system_prompt": {
                "personaPrefix": "You are the EM Analyst / 环境监测分析员. Inspect environmental evidence, distinguish alert/action limits and assess linked batch impact. Preserve original values and return evidence-based findings in the task language. Do not schedule, write records or sign; hand consequential actions to the main Quality Assistant."
              }
            }
          }
        },
        "launch": {
          "title": {
            "en": "EM Analyst",
            "zh-CN": "环境监测分析员"
          },
          "description": {
            "en": "Analyze C-201 EM trends, distinguish alert/action limits and generate an English nightly EM report.",
            "zh-CN": "分析 C-201 环境趋势，区别警戒与行动限；生成中文夜间 EM 趋势报告。"
          },
          "preset": "gmp",
          "pages": [
            "pharma-home"
          ],
          "prompt": {
            "mode": "draft",
            "text": {
              "en": "Analyze C-201 EM trends, distinguish alert/action limits and generate an English nightly EM report.",
              "zh-CN": "分析 C-201 环境趋势，区别警戒与行动限；生成中文夜间 EM 趋势报告。"
            }
          }
        }
      },
      "release": {
        "profile": {
          "tools": [
            "pharma_inspect",
            "pharma_dossier",
            "pharma_report",
            "present",
            "ask_user_question",
            "read",
            "ui_render",
            "skill_read",
            "pharma_release"
          ],
          "skills": [
            "gmp-review"
          ],
          "toolPolicy": {
            "allow": [
              "pharma_inspect",
              "pharma_dossier",
              "pharma_report",
              "present",
              "ask_user_question",
              "read",
              "ui_render",
              "skill_read",
              "pharma_release"
            ]
          }
        },
        "presets": {
          "gmp": {
            "name": "gmp",
            "extends": "standard",
            "providers": {
              "tool-policy": {
                "provider": "sableleaf-quality"
              }
            },
            "model": {
              "system_prompt": {
                "personaPrefix": "You are the QA pre-release checker / QA 放行前检查员. Read the latest batch dossier and every release prerequisite. Return the exact reviewed revision, evidence and blockers in the task language. Do not release or sign: the main Quality Assistant must reread current revision, summarize findings and perform any explicitly requested signed release itself. Missing evidence blocks release."
              }
            }
          }
        },
        "launch": {
          "title": {
            "en": "QA Release Assistant",
            "zh-CN": "QA 放行助理"
          },
          "description": {
            "en": "Build B-2410-017 release dossier and explain blockers. Only when all prerequisites pass request human approval with signature meaning, then generate the dossier.",
            "zh-CN": "构建 B-2410-017 放行清单，说明阻断项。满足所有条件后才请求人工批准并记录签名含义，最后生成档案。"
          },
          "preset": "gmp",
          "pages": [
            "pharma-home"
          ],
          "prompt": {
            "mode": "draft",
            "text": {
              "en": "Build B-2410-017 release dossier and explain blockers. Only when all prerequisites pass request human approval with signature meaning, then generate the dossier.",
              "zh-CN": "构建 B-2410-017 放行清单，说明阻断项。满足所有条件后才请求人工批准并记录签名含义，最后生成档案。"
            }
          }
        }
      }
    },
    "application": {
      "id": "sableleaf-quality",
      "brand": {
        "name": {
          "en": "Sableleaf OSD",
          "zh-CN": "沙叶制剂"
        },
        "title": {
          "en": "Sableleaf · GMP Quality Hub",
          "zh-CN": "沙叶 · GMP 质量中枢"
        },
        "assistantName": {
          "en": "Quality Assistant",
          "zh-CN": "质量助手"
        },
        "mark": "assets/mark.png",
        "favicon": "assets/favicon.png"
      },
      "presentation": {
        "skin": "sableleaf",
        "home": "@agnes-showcase/pharma-gmp#pharma-home",
        "navigation": {
          "entries": [
            "@agnes-showcase/pharma-gmp#pharma-home",
            "@agnes-showcase/pharma-gmp#pharma-tasks"
          ],
          "hideBuiltin": [
            "agents",
            "business-agents",
            "automation",
            "schedules",
            "triggers",
            "plugins"
          ]
        }
      },
      "defaultAgent": "@agnes-showcase/pharma-gmp#hub",
      "agents": [
        "@agnes-showcase/pharma-gmp#hub",
        "@agnes-showcase/pharma-gmp#reviewer",
        "@agnes-showcase/pharma-gmp#investigator",
        "@agnes-showcase/pharma-gmp#em",
        "@agnes-showcase/pharma-gmp#release"
      ],
      "workbench": {
        "tabs": [
          {
            "id": "current-object",
            "title": {
              "en": "Current object",
              "zh-CN": "当前对象"
            },
            "icon": "file",
            "order": -30,
            "slot": "workbench.panel",
            "view": "page",
            "page": "@agnes-showcase/pharma-gmp#pharma-object",
            "when": "session"
          },
          {
            "id": "signatures",
            "title": {
              "en": "Pending signatures",
              "zh-CN": "待签署"
            },
            "icon": "check",
            "order": -20,
            "slot": "workbench.panel",
            "view": "signatures"
          },
          {
            "id": "evidence",
            "title": {
              "en": "Evidence & reports",
              "zh-CN": "证据与报告"
            },
            "icon": "list",
            "order": -10,
            "slot": "workbench.panel",
            "view": "evidence"
          }
        ],
        "actions": [
          {
            "id": "investigate",
            "title": {
              "en": "Investigate deviation",
              "zh-CN": "调查偏差"
            },
            "agent": "@agnes-showcase/pharma-gmp#hub",
            "prompt": {
              "en": "Read the selected deviation and linked batches; distinguish original findings, hypotheses and confirmed causes.",
              "zh-CN": "读取所选偏差与关联批次证据，区分原始发现、假设和确认根因。"
            },
            "object": {
              "type": "deviation",
              "id": "DEV-2410-017"
            },
            "focusTab": "current-object"
          },
          {
            "id": "capa",
            "title": {
              "en": "Draft CAPA",
              "zh-CN": "起草 CAPA"
            },
            "agent": "@agnes-showcase/pharma-gmp#hub",
            "prompt": {
              "en": "Draft actions, owners and effectiveness checks for the selected deviation or CAPA; do not claim missing evidence is complete.",
              "zh-CN": "为所选偏差或 CAPA 起草措施、责任人与有效性检查，不将缺失证据描述为已完成。"
            },
            "object": {
              "type": "deviation",
              "id": "DEV-2410-017"
            },
            "focusTab": "current-object"
          },
          {
            "id": "em",
            "title": {
              "en": "Assess EM excursion",
              "zh-CN": "评估 EM 超限"
            },
            "agent": "@agnes-showcase/pharma-gmp#hub",
            "prompt": {
              "en": "Assess the selected EM result, alert/action limits and linked batch impact, retaining original values.",
              "zh-CN": "评估所选环境监测结果、警戒与行动限度及关联批次影响，保留原始数值。"
            },
            "object": {
              "type": "em",
              "id": "EM-0017"
            },
            "focusTab": "current-object"
          },
          {
            "id": "review",
            "title": {
              "en": "Review batch record",
              "zh-CN": "批记录复核"
            },
            "agent": "@agnes-showcase/pharma-gmp#hub",
            "prompt": {
              "en": "Review the selected batch originals, LOD, calibration, deviations and independent retest evidence.",
              "zh-CN": "复核所选批次的原始记录、LOD、设备校准、偏差与复验依据。"
            },
            "object": {
              "type": "batch",
              "id": "B-2410-017"
            },
            "focusTab": "current-object"
          },
          {
            "id": "release",
            "title": {
              "en": "Request QA release",
              "zh-CN": "发起 QA 放行"
            },
            "agent": "@agnes-showcase/pharma-gmp#hub",
            "prompt": {
              "en": "Check release prerequisites for the selected batch; once complete, use Host confirmation under the current permission mode and generate the release certificate.",
              "zh-CN": "检查所选批次放行前提，完整后按当前权限提交宿主签署流程并生成放行证书。"
            },
            "object": {
              "type": "batch",
              "id": "B-2410-017"
            },
            "focusTab": "current-object"
          }
        ],
        "scenarios": [
          {
            "en": "LOD excursion → investigation → CAPA → batch review",
            "zh-CN": "干燥失重超限 → 偏差调查 → CAPA → 批记录复核"
          },
          {
            "en": "EM alert → impact assessment → linked batch evidence",
            "zh-CN": "EM 警戒 → 影响评估 → 关联批次证据"
          },
          {
            "en": "Complete dossier → QA signature → release certificate",
            "zh-CN": "完整档案 → QA 签署 → 放行证书"
          }
        ],
        "includes": [
          "pages",
          "tools",
          "signatures",
          "reports"
        ]
      },
      "delegableAgents": [
        "@agnes-showcase/pharma-gmp#investigator",
        "@agnes-showcase/pharma-gmp#reviewer",
        "@agnes-showcase/pharma-gmp#em",
        "@agnes-showcase/pharma-gmp#release"
      ]
    },
    "metadata": {
      "displayName": "Sableleaf GMP Quality Hub",
      "summary": "Fictional OSD quality application: batch evidence, deviation/CAPA, EM and human-approved QA release.",
      "description": "Synthetic pharmaceutical quality workbench with batch evidence, internal roles and QA signatures.",
      "locales": {
        "zh-CN": {
          "displayName": "沙叶 GMP 质量中枢",
          "summary": "虚构固体制剂质量应用：批记录、偏差/CAPA、EM 和人工批准的 QA 放行。",
          "description": "围绕批次证据、内部角色协作与 QA 签署开展工作的合成质量工作台。"
        }
      }
    }
  }
}
