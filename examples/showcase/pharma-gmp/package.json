    "application": {
      "id": "sableleaf-quality",
      "brand": {
        "name": {
          "en": "Sableleaf OSD",
          "zh-CN": "沙叶制剂"
        },
        "title": {
          "en": "Sableleaf · GMP Quality Hub",
          "zh-CN": "沙叶 · GMP 质量中枢"
        },
        "assistantName": {
          "en": "Quality Assistant",
          "zh-CN": "质量助手"
        },
        "mark": "assets/mark.png",
        "favicon": "assets/favicon.png"
      },
      "presentation": {
        "skin": "sableleaf",
        "home": "@agnes-showcase/pharma-gmp#pharma-home",
        "navigation": {
          "entries": [
            "@agnes-showcase/pharma-gmp#pharma-home",
            "@agnes-showcase/pharma-gmp#pharma-batches",
            "@agnes-showcase/pharma-gmp#pharma-deviations",
            "@agnes-showcase/pharma-gmp#pharma-em",
            "@agnes-showcase/pharma-gmp#pharma-release",
            "@agnes-showcase/pharma-gmp#pharma-audit"
          ],
          "hideBuiltin": []
        }
      },
      "defaultAgent": "@agnes-showcase/pharma-gmp#hub",
      "agents": [
        "@agnes-showcase/pharma-gmp#hub",
        "@agnes-showcase/pharma-gmp#reviewer",
