{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": false,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist/types",
    "composite": true,
    "emitDeclarationOnly": true
  },
  "include": ["src/**/*.ts"],
  "extends": "../../../tsconfig.base.json",
  "references": [
    {
      "path": "../../../packages/extension-api"
    },
    {
      "path": "../../../packages/plugin-runtime"
    }
  ]
}
