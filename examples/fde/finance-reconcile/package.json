{
  "name": "@agnes-fde/finance-reconcile",
  "version": "1.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.10"
  },
  "exports": "./index.mjs",
  "files": [
    "*.mjs",
    "fixtures",
    "skills",
    "client",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "real-model.bundle.json"
  ],
  "scripts": {
    "build": "node --check index.mjs && node --check runtime.mjs && node --check ledgers.mjs && node --check surface.mjs",
    "test": "vitest run test/workflow.test.mjs --maxWorkers=1"
  },
  "dependencies": {
    "@agnes/extension-api": "1.4.0",
    "@agnes/intelligent-ui-contract": "0.0.0",
    "@agnes/plugin-runtime": "0.0.0",
    "@sinclair/typebox": "0.34.33",
    "@agnes/protocol": "0.0.0"
  },
  "agnes": {
    "kinds": [
      "bundle",
      "loop",
      "tool",
      "skills",
      "ui"
    ],
    "capabilities": {
      "model": true,
      "filesystem": {
        "read": [
          "fixtures/**",
          "skills/playbook/SKILL.md",
          "fde-output/finance-reconcile/**"
        ],
        "write": [
          "fde-output/finance-reconcile/**"
        ]
      },
      "uiData": [
        "finance.differences.read"
      ]
    },
    "plugins": [
      {
        "export": "main",
        "id": "ext:@agnes-fde/finance-reconcile/main",
        "inject": [
          "extension",
          "loops",
          "toolPolicies",
          "skills",
          "providers"
        ],
        "apiRange": "^1.4.0",
        "metadata": {
          "displayName": "Ledger reconciliation example",
          "summary": "Compares sample bank and book ledgers, then prepares balanced simulated adjustments for approval.",
          "description": "Compares sample bank and book ledgers, then prepares balanced simulated adjustments for approval.",
          "category": "tools",
          "locales": {
            "zh-CN": {
              "displayName": "账目核对示例",
              "summary": "核对样例银行账与账簿，准备平衡的模拟调整分录供批准。",
              "description": "核对样例银行账与账簿，准备平衡的模拟调整分录供批准。"
            }
          }
        }
      }
    ],
    "bundles": {
      "finance-reconcile": {
        "profile": {
          "loop": {
            "id": "fde.finance-reconcile",
            "version": "4.0.0"
          },
          "skills": [
            "finance-reconcile"
          ]
        },
        "presets": {
          "finance-reconcile": {
            "name": "finance-reconcile",
            "extends": "standard",
            "approval": {
              "policy": "fde.finance-reconcile"
            },
            "model": {
              "route": {
                "primary": {
                  "route": "demo",
                  "model": "demo-model"
                }
              }
            }
          }
        }
      }
    },
    "clientDescriptors": [
      {
        "rowId": "ext:@agnes-fde/finance-reconcile/main",
        "path": "./client/agnes.client.json"
      }
    ],
    "metadata": {
      "displayName": "Ledger reconciliation example",
      "summary": "Compares sample bank and book ledgers, then prepares balanced simulated adjustments for approval.",
      "description": "Compares sample bank and book ledgers, then prepares balanced simulated adjustments for approval.",
      "category": "tools",
      "locales": {
        "zh-CN": {
          "displayName": "账目核对示例",
          "summary": "核对样例银行账与账簿，准备平衡的模拟调整分录供批准。",
          "description": "核对样例银行账与账簿，准备平衡的模拟调整分录供批准。"
        }
      }
    }
  },
  "devDependencies": {
    "@agnes/host": "0.0.0",
    "@agnes/resource-control-runtime": "0.0.0",
    "vitest": "5.0.0"
  }
}
