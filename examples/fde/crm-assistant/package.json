{
  "name": "@agnes-fde/crm-assistant",
  "version": "1.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.10"
  },
  "exports": "./index.mjs",
  "files": [
    "*.mjs",
    "fixtures",
    "skills",
    "client",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "mcp",
    "real-model.bundle.json"
  ],
  "scripts": {
    "build": "node --check index.mjs",
    "test": "vitest run test/workflow.e2e.test.mjs --maxWorkers=1"
  },
  "dependencies": {
    "@agnes/extension-api": "^4.0.0",
    "@agnes/plugin-runtime": "0.0.0",
    "@sinclair/typebox": "0.34.33",
    "@agnes/protocol": "0.0.0"
  },
  "agnes": {
    "kinds": [
      "bundle",
      "loop",
      "tool",
      "skills",
      "mcp"
    ],
    "plugins": [
      {
        "export": "main",
        "apiRange": "^4.0.0",
        "id": "ext:@agnes-fde/crm-assistant/main",
        "inject": [
          "tools",
          "providers",
          "skills"
        ],
        "metadata": {
          "displayName": "CRM follow-up example",
          "summary": "Uses sample customer health and tickets to draft a renewal note and record it in a local CRM simulator after approval.",
          "description": "Uses sample customer health and tickets to draft a renewal note and record it in a local CRM simulator after approval.",
          "category": "business-agent",
          "locales": {
            "zh-CN": {
              "displayName": "CRM 跟进示例",
              "summary": "根据样例客户健康度与工单起草续约备注，经批准后写入本地 CRM 模拟器。",
              "description": "根据样例客户健康度与工单起草续约备注，经批准后写入本地 CRM 模拟器。"
            }
          }
        },
        "capabilities": {
          "model": true,
          "filesystem": {
            "read": [
              "fixtures/*",
              "skills/playbook/SKILL.md",
              "fde-output/crm-assistant/**"
            ],
            "write": [
              "fde-output/crm-assistant/**"
            ]
          },
          "exec": [
            "node"
          ]
        }
      }
    ],
    "bundles": {
      "crm-assistant": {
        "profile": {
          "skills": [
            "crm-assistant"
          ],
          "providers": {
            "loop": {
              "version": "5.0.0",
              "provider": "fde.crm-assistant"
            }
          }
        },
        "presets": {
          "crm-assistant": {
            "name": "crm-assistant",
            "extends": "standard",
            "model": {
              "route": {
                "primary": {
                  "route": "demo",
                  "model": "demo-model"
                }
              }
            },
            "providers": {
              "tool-policy": {
                "provider": "fde.crm-assistant"
              }
            }
          }
        }
      }
    },
    "metadata": {
      "displayName": "CRM follow-up example",
      "summary": "Uses sample customer health and tickets to draft a renewal note and record it in a local CRM simulator after approval.",
      "description": "Uses sample customer health and tickets to draft a renewal note and record it in a local CRM simulator after approval.",
      "category": "business-agent",
      "samplePrompt": {
        "en": "Look up the sample account's health and open tickets, draft a renewal follow-up note from the renewal playbook, and ask me before saving it to the CRM.",
        "zh-CN": "查询示例客户的健康度和未结工单，按续约手册起草一条续约跟进记录，写入 CRM 前先问我。"
      },
      "locales": {
        "zh-CN": {
          "displayName": "CRM 跟进示例",
          "summary": "根据样例客户健康度与工单起草续约备注，经批准后写入本地 CRM 模拟器。",
          "description": "根据样例客户健康度与工单起草续约备注，经批准后写入本地 CRM 模拟器。"
        }
      }
    }
  },
  "devDependencies": {
    "@agnes/host": "0.0.0",
    "@agnes/resource-control-runtime": "0.0.0",
    "vitest": "5.0.0"
  }
}
