{
  "name": "@agnes-fde/contract-review",
  "version": "1.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.10"
  },
  "exports": "./index.mjs",
  "files": [
    "*.mjs",
    "fixtures",
    "skills",
    "client",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "real-model.bundle.json"
  ],
  "scripts": {
    "build": "node --check index.mjs && node --check runtime.mjs",
    "test": "vitest run test/workflow.test.mjs --maxWorkers=1"
  },
  "dependencies": {
    "@agnes/extension-api": "1.4.0",
    "@agnes/plugin-runtime": "0.0.0",
    "@sinclair/typebox": "0.34.33",
    "@agnes/protocol": "0.0.0"
  },
  "agnes": {
    "kinds": [
      "bundle",
      "loop",
      "tool",
      "skills"
    ],
    "capabilities": {
      "model": true,
      "filesystem": {
        "read": [
          "fixtures/*",
          "skills/playbook/SKILL.md",
          "fde-output/contract-review/**"
        ],
        "write": [
          "fde-output/contract-review/**"
        ]
      }
    },
    "plugins": [
      {
        "export": "main",
        "apiRange": "^1.4.0",
        "id": "ext:@agnes-fde/contract-review/main",
        "inject": [
          "extension",
          "loops",
          "toolPolicies",
          "skills"
        ]
      }
    ],
    "bundles": {
      "contract-review": {
        "profile": {
          "loop": {
            "id": "fde.contract-review",
            "version": "3.0.0"
          },
          "skills": [
            "contract-review"
          ]
        },
        "presets": {
          "contract-review": {
            "name": "contract-review",
            "extends": "standard",
            "approval": {
              "policy": "fde.contract-review"
            },
            "model": {
              "route": {
                "primary": {
                  "route": "demo",
                  "model": "demo-model"
                }
              }
            }
          }
        }
      }
    }
  },
  "devDependencies": {
    "@agnes/host": "0.0.0",
    "@agnes/resource-control-runtime": "0.0.0",
    "vitest": "5.0.0"
  }
}
