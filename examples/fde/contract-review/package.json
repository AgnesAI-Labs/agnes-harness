{
  "name": "@agnes-fde/contract-review",
  "version": "1.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.10"
  },
  "exports": "./index.mjs",
  "files": [
    "*.mjs",
    "fixtures",
    "skills",
    "client",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "real-model.bundle.json"
  ],
  "scripts": {
    "build": "node --check index.mjs",
    "test": "vitest run test/workflow.test.mjs --maxWorkers=1"
  },
  "dependencies": {
    "@agnes/extension-api": "^4.0.0",
    "@agnes/plugin-runtime": "0.0.0",
    "@sinclair/typebox": "0.34.33",
    "@agnes/protocol": "0.0.0"
  },
  "agnes": {
    "plugins": [
      {
        "export": "main",
        "apiRange": "^4.0.0",
        "id": "ext:@agnes-fde/contract-review/main",
        "inject": [
          "tools",
          "providers",
          "skills"
        ],
        "metadata": {
          "displayName": "Contract review example",
          "summary": "Reviews sample contract clauses in parallel and prepares a risk draft for a qualified reviewer.",
          "description": "Reviews sample contract clauses in parallel and prepares a risk draft for a qualified reviewer.",
          "locales": {
            "zh-CN": {
              "displayName": "合同审查示例",
              "summary": "并行检查样例合同条款，为专业审核者准备风险草稿。",
              "description": "并行检查样例合同条款，为专业审核者准备风险草稿。"
            }
          }
        },
        "capabilities": {
          "model": true,
          "filesystem": {
            "read": [
              "fixtures/*",
              "skills/playbook/SKILL.md",
              "fde-output/contract-review/**"
            ],
            "write": [
              "fde-output/contract-review/**"
            ]
          }
        }
      }
    ],
    "bundles": {
      "contract-review": {
        "profile": {
          "skills": [
            "contract-review"
          ],
          "providers": {
            "loop": {
              "version": "5.0.0",
              "provider": "fde.contract-review"
            }
          }
        },
        "presets": {
          "contract-review": {
            "name": "contract-review",
            "extends": "standard",
            "model": {
              "route": {
                "primary": {
                  "route": "demo",
                  "model": "demo-model"
                }
              }
            },
            "providers": {
              "tool-policy": {
                "provider": "fde.contract-review"
              }
            }
          }
        },
        "launch": {
          "title": {
            "en": "Contract review example",
            "zh-CN": "合同审查示例"
          },
          "description": {
            "en": "Reviews sample contract clauses in parallel and prepares a risk draft for a qualified reviewer."
          },
          "preset": "contract-review"
        }
      }
    },
    "metadata": {
      "displayName": "Contract review example",
      "summary": "Reviews sample contract clauses in parallel and prepares a risk draft for a qualified reviewer.",
      "description": "Reviews sample contract clauses in parallel and prepares a risk draft for a qualified reviewer.",
      "samplePrompt": {
        "en": "Review the sample supplier contract clause by clause, flag unlimited liability and one-sided change terms, and prepare a risk report for a qualified reviewer.",
        "zh-CN": "逐条审查示例供应商合同，标出无限责任和单方变更条款，并整理一份供专业审核者复核的风险报告。"
      },
      "locales": {
        "zh-CN": {
          "displayName": "合同审查示例",
          "summary": "并行检查样例合同条款，为专业审核者准备风险草稿。",
          "description": "并行检查样例合同条款，为专业审核者准备风险草稿。"
        }
      }
    },
    "provides": [
      "bundle",
      "loop",
      "tool",
      "skills"
    ]
  },
  "devDependencies": {
    "@agnes/host": "0.0.0",
    "@agnes/resource-control-runtime": "0.0.0",
    "vitest": "5.0.0"
  }
}
