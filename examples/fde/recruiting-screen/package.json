{
  "name": "@agnes-fde/recruiting-screen",
  "version": "1.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.10"
  },
  "exports": "./index.mjs",
  "files": [
    "*.mjs",
    "fixtures",
    "skills",
    "client",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "real-model.bundle.json"
  ],
  "scripts": {
    "build": "node --check index.mjs",
    "test": "vitest run test/workflow.test.mjs --maxWorkers=1"
  },
  "dependencies": {
    "@agnes/extension-api": "^4.0.0",
    "@agnes/plugin-runtime": "0.0.0",
    "@sinclair/typebox": "0.34.33",
    "@agnes/protocol": "0.0.0"
  },
  "agnes": {
    "plugins": [
      {
        "export": "main",
        "id": "ext:@agnes-fde/recruiting-screen/main",
        "inject": [
          "tools",
          "providers",
          "skills"
        ],
        "apiRange": "^4.0.0",
        "metadata": {
          "displayName": "Recruiting review example",
          "summary": "Scores synthetic applications against a fixed rubric and prepares a report for human review.",
          "description": "Scores synthetic applications against a fixed rubric and prepares a report for human review.",
          "locales": {
            "zh-CN": {
              "displayName": "招聘审核示例",
              "summary": "按固定标准评估模拟申请材料，并生成供人工审核的报告。",
              "description": "按固定标准评估模拟申请材料，并生成供人工审核的报告。"
            }
          }
        },
        "capabilities": {
          "model": true,
          "filesystem": {
            "read": [
              "fixtures/**",
              "skills/playbook/SKILL.md",
              "fde-output/recruiting-screen/**"
            ],
            "write": [
              "fde-output/recruiting-screen/**"
            ]
          }
        }
      }
    ],
    "bundles": {
      "recruiting-screen": {
        "profile": {
          "skills": [
            "recruiting-screen"
          ],
          "providers": {
            "loop": {
              "version": "5.0.0",
              "provider": "fde.recruiting-screen"
            }
          }
        },
        "presets": {
          "recruiting-screen": {
            "name": "recruiting-screen",
            "extends": "standard",
            "model": {
              "route": {
                "primary": {
                  "route": "demo",
                  "model": "demo-model"
                }
              }
            },
            "providers": {
              "tool-policy": {
                "provider": "fde.recruiting-screen"
              }
            }
          }
        },
        "launch": {
          "title": {
            "en": "Recruiting review example",
            "zh-CN": "招聘审核示例"
          },
          "description": {
            "en": "Scores synthetic applications against a fixed rubric and prepares a report for human review."
          },
          "preset": "recruiting-screen"
        }
      }
    },
    "metadata": {
      "displayName": "Recruiting review example",
      "summary": "Scores synthetic applications against a fixed rubric and prepares a report for human review.",
      "description": "Scores synthetic applications against a fixed rubric and prepares a report for human review.",
      "samplePrompt": {
        "en": "Compare the sample resumes with the job rubric using job-skill evidence only, list what is unknown for each candidate, and ask me to confirm the follow-up step.",
        "zh-CN": "只依据岗位技能证据，把示例简历与岗位评分标准逐项对照，列出每位候选人的未知项，并请我确认后续步骤。"
      },
      "locales": {
        "zh-CN": {
          "displayName": "招聘审核示例",
          "summary": "按固定标准评估模拟申请材料，并生成供人工审核的报告。",
          "description": "按固定标准评估模拟申请材料，并生成供人工审核的报告。"
        }
      }
    },
    "provides": [
      "bundle",
      "loop",
      "tool",
      "skills"
    ]
  },
  "devDependencies": {
    "@agnes/host": "0.0.0",
    "@agnes/resource-control-runtime": "0.0.0",
    "vitest": "5.0.0"
  }
}
