{
  "name": "@agnes-fde/support-triage",
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.10"
  },
  "exports": "./index.mjs",
  "files": [
    "*.mjs",
    "fixtures",
    "skills",
    "client",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "real-model.bundle.json"
  ],
  "scripts": {
    "build": "node --check index.mjs && node --check runtime.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@agnes/extension-api": "1.4.0",
    "@agnes/plugin-runtime": "0.0.0",
    "@sinclair/typebox": "0.34.33"
  },
  "agnes": {
    "kinds": [
      "bundle",
      "loop",
      "tool",
      "skills",
      "ui"
    ],
    "capabilities": {
      "model": true,
      "filesystem": {
        "read": [
          "fixtures/*",
          "skills/playbook/SKILL.md"
        ]
      },
      "ui": true
    },
    "plugins": [
      {
        "export": "main",
        "id": "ext:@agnes-fde/support-triage/main",
        "inject": [
          "extension",
          "loops",
          "toolPolicies",
          "skills"
        ]
      }
    ],
    "bundles": {
      "support-triage": {
        "profile": {
          "loop": {
            "id": "fde.support-triage",
            "version": "1.0.0"
          },
          "skills": [
            "support-triage"
          ]
        },
        "presets": {
          "support-triage": {
            "name": "support-triage",
            "extends": "standard",
            "approval": {
              "policy": "fde.support-triage"
            }
          }
        }
      }
    },
    "clientDescriptors": [
      {
        "rowId": "ext:@agnes-fde/support-triage/main",
        "path": "./client/agnes.client.json"
      }
    ]
  },
  "peerDependencies": {
    "react": "18.3.1"
  },
  "devDependencies": {
    "@agnes/host": "0.0.0",
    "@agnes/resource-control-runtime": "0.0.0"
  }
}
