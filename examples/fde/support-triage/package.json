{
  "name": "@agnes-fde/support-triage",
  "version": "1.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.10"
  },
  "exports": "./index.mjs",
  "files": [
    "*.mjs",
    "fixtures",
    "skills",
    "client",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "real-model.bundle.json"
  ],
  "scripts": {
    "build": "node --check index.mjs && node --check runtime.mjs",
    "test": "vitest run test/workflow.test.mjs --maxWorkers=1"
  },
  "dependencies": {
    "@agnes/extension-api": "1.4.0",
    "@agnes/plugin-runtime": "0.0.0",
    "@sinclair/typebox": "0.34.33",
    "@agnes/protocol": "0.0.0"
  },
  "agnes": {
    "kinds": [
      "bundle",
      "loop",
      "tool",
      "skills",
      "ui"
    ],
    "capabilities": {
      "model": true,
      "filesystem": {
        "read": [
          "fixtures/*",
          "skills/playbook/SKILL.md",
          "fde-output/support-triage/**"
        ],
        "write": [
          "fde-output/support-triage/**"
        ]
      },
      "ui": true
    },
    "plugins": [
      {
        "export": "main",
        "apiRange": "^1.4.0",
        "id": "ext:@agnes-fde/support-triage/main",
        "inject": [
          "extension",
          "loops",
          "toolPolicies",
          "skills"
        ],
        "metadata": {
          "displayName": "Support triage example",
          "summary": "Classifies sample support tickets and requests approval before recording a simulated reply.",
          "description": "Classifies sample support tickets and requests approval before recording a simulated reply.",
          "category": "agent-loop",
          "locales": {
            "zh-CN": {
              "displayName": "客服分流示例",
              "summary": "对样例客服工单分类，并在记录模拟回复前请求批准。",
              "description": "对样例客服工单分类，并在记录模拟回复前请求批准。"
            }
          }
        }
      }
    ],
    "bundles": {
      "support-triage": {
        "profile": {
          "loop": {
            "id": "fde.support-triage",
            "version": "4.0.0"
          },
          "skills": [
            "support-triage"
          ]
        },
        "presets": {
          "support-triage": {
            "name": "support-triage",
            "extends": "standard",
            "approval": {
              "policy": "fde.support-triage"
            },
            "model": {
              "route": {
                "primary": {
                  "route": "demo",
                  "model": "demo-model"
                }
              }
            }
          }
        }
      }
    },
    "clientDescriptors": [
      {
        "rowId": "ext:@agnes-fde/support-triage/main",
        "path": "./client/agnes.client.json"
      }
    ],
    "metadata": {
      "displayName": "Support triage example",
      "summary": "Classifies sample support tickets and requests approval before recording a simulated reply.",
      "description": "Classifies sample support tickets and requests approval before recording a simulated reply.",
      "category": "agent-loop",
      "locales": {
        "zh-CN": {
          "displayName": "客服分流示例",
          "summary": "对样例客服工单分类，并在记录模拟回复前请求批准。",
          "description": "对样例客服工单分类，并在记录模拟回复前请求批准。"
        }
      }
    }
  },
  "peerDependencies": {
    "react": "18.3.1"
  },
  "devDependencies": {
    "@agnes/host": "0.0.0",
    "@agnes/resource-control-runtime": "0.0.0",
    "vitest": "5.0.0"
  }
}
