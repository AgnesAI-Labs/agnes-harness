{
  "name": "@agnes-fde/support-triage",
  "version": "1.1.1",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.10"
  },
  "exports": "./index.mjs",
  "files": [
    "*.mjs",
    "fixtures",
    "skills",
    "client",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "real-model.bundle.json"
  ],
  "scripts": {
    "build": "node --check index.mjs",
    "test": "vitest run test/workflow.test.mjs --maxWorkers=1"
  },
  "dependencies": {
    "@agnes/extension-api": "^5.0.0",
    "@agnes/plugin-runtime": "0.0.0",
    "@sinclair/typebox": "0.34.33",
    "@agnes/protocol": "0.0.0"
  },
  "agnes": {
    "plugins": [
      {
        "export": "main",
        "apiRange": "^5.0.0",
        "id": "ext:@agnes-fde/support-triage/main",
        "inject": [
          "tools",
          "providers",
          "skills"
        ],
        "metadata": {
          "displayName": "Support triage example",
          "summary": "Classifies sample support tickets and requests approval before recording a simulated reply.",
          "description": "Classifies sample support tickets and requests approval before recording a simulated reply.",
          "locales": {
            "zh-CN": {
              "displayName": "客服分流示例",
              "summary": "对样例客服工单分类，并在记录模拟回复前请求批准。",
              "description": "对样例客服工单分类，并在记录模拟回复前请求批准。"
            }
          }
        },
        "capabilities": {
          "model": true,
          "filesystem": {
            "read": [
              "fixtures/*",
              "skills/playbook/SKILL.md",
              "fde-output/support-triage/**"
            ],
            "write": [
              "fde-output/support-triage/**"
            ]
          },
          "ui": true
        }
      }
    ],
    "bundles": {
      "support-triage": {
        "profile": {
          "skills": [
            "support-triage"
          ],
          "providers": {
            "loop": {
              "version": "5.0.0",
              "provider": "fde.support-triage"
            }
          }
        },
        "presets": {
          "support-triage": {
            "name": "support-triage",
            "extends": "standard",
            "providers": {
              "tool-policy": {
                "provider": "fde.support-triage"
              }
            }
          }
        },
        "launch": {
          "title": {
            "en": "Support triage example",
            "zh-CN": "客服分流示例"
          },
          "description": {
            "en": "Classifies sample support tickets and requests approval before recording a simulated reply."
          },
          "preset": "support-triage",
          "prompt": {
            "text": {
              "en": "Look up the sample support ticket, classify its type and priority, draft a reply to the customer, and ask me before sending it.",
              "zh-CN": "查询示例客服工单，判断类型和优先级，起草给客户的回复，发送前先问我。"
            },
            "mode": "draft"
          }
        }
      }
    },
    "clientDescriptors": [
      {
        "rowId": "ext:@agnes-fde/support-triage/main",
        "path": "./client/agnes.client.json"
      }
    ],
    "metadata": {
      "displayName": "Support triage example",
      "summary": "Classifies sample support tickets and requests approval before recording a simulated reply.",
      "description": "Classifies sample support tickets and requests approval before recording a simulated reply.",
      "samplePrompt": {
        "en": "Look up the sample support ticket, classify its type and priority, draft a reply to the customer, and ask me before sending it.",
        "zh-CN": "查询示例客服工单，判断类型和优先级，起草给客户的回复，发送前先问我。"
      },
      "locales": {
        "zh-CN": {
          "displayName": "客服分流示例",
          "summary": "对样例客服工单分类，并在记录模拟回复前请求批准。",
          "description": "对样例客服工单分类，并在记录模拟回复前请求批准。"
        }
      }
    },
    "provides": [
      "bundle",
      "loop",
      "tool",
      "skills",
      "ui"
    ]
  },
  "peerDependencies": {
    "react": "18.3.1"
  },
  "devDependencies": {
    "@agnes/host": "0.0.0",
    "@agnes/resource-control-runtime": "0.0.0",
    "vitest": "5.0.0"
  }
}
