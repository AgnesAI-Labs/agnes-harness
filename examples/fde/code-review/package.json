{
  "name": "@agnes-fde/code-review",
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.10"
  },
  "exports": "./index.mjs",
  "files": [
    "*.mjs",
    "fixtures",
    "skills",
    "client",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "real-model.bundle.json"
  ],
  "scripts": {
    "build": "node --check index.mjs && node --check runtime.mjs",
    "test": "vitest run test/workflow.test.mjs --maxWorkers=1"
  },
  "dependencies": {
    "@agnes/extension-api": "1.4.0",
    "@agnes/plugin-runtime": "0.0.0",
    "@sinclair/typebox": "0.34.33"
  },
  "agnes": {
    "kinds": [
      "bundle",
      "loop",
      "tool",
      "skills"
    ],
    "capabilities": {
      "model": true,
      "filesystem": {
        "read": [
          "fixtures/**",
          "skills/playbook/SKILL.md"
        ]
      }
    },
    "plugins": [
      {
        "export": "main",
        "id": "ext:@agnes-fde/code-review/main",
        "inject": [
          "extension",
          "loops",
          "toolPolicies",
          "skills"
        ],
        "apiRange": "^1.4.0"
      }
    ],
    "bundles": {
      "code-review": {
        "profile": {
          "loop": {
            "id": "fde.code-review",
            "version": "1.0.0"
          },
          "skills": [
            "code-review"
          ],
          "toolPolicy": {
            "readOnly": true
          }
        },
        "presets": {
          "code-review": {
            "name": "code-review",
            "extends": "standard",
            "approval": {
              "policy": "fde.code-review"
            },
            "model": {
              "route": {
                "primary": {
                  "route": "demo",
                  "model": "demo-model"
                }
              }
            }
          }
        }
      }
    }
  },
  "devDependencies": {
    "@agnes/host": "0.0.0",
    "@agnes/resource-control-runtime": "0.0.0",
    "vitest": "5.0.0"
  }
}
