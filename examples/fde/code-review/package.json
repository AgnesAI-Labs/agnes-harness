{
  "name": "@agnes-fde/code-review",
  "version": "1.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.10"
  },
  "exports": "./index.mjs",
  "files": [
    "*.mjs",
    "fixtures",
    "skills",
    "client",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "real-model.bundle.json"
  ],
  "scripts": {
    "build": "node --check index.mjs",
    "test": "vitest run test/workflow.test.mjs --maxWorkers=1"
  },
  "dependencies": {
    "@agnes/extension-api": "^4.0.0",
    "@agnes/plugin-runtime": "0.0.0",
    "@sinclair/typebox": "0.34.33",
    "@agnes/protocol": "0.0.0"
  },
  "agnes": {
    "kinds": [
      "bundle",
      "loop",
      "tool",
      "skills"
    ],
    "plugins": [
      {
        "export": "main",
        "id": "ext:@agnes-fde/code-review/main",
        "inject": [
          "tools",
          "providers",
          "skills"
        ],
        "apiRange": "^4.0.0",
        "metadata": {
          "displayName": "Code review example",
          "summary": "Reviews a synthetic patch for selected risks and prepares an evidence-linked report for a maintainer.",
          "description": "Reviews a synthetic patch for selected risks and prepares an evidence-linked report for a maintainer.",
          "category": "developer",
          "locales": {
            "zh-CN": {
              "displayName": "代码审查示例",
              "summary": "检查模拟补丁中的特定风险，为维护者生成附带证据的审查报告。",
              "description": "检查模拟补丁中的特定风险，为维护者生成附带证据的审查报告。"
            }
          }
        },
        "capabilities": {
          "model": true,
          "filesystem": {
            "read": [
              "fixtures/**",
              "skills/playbook/SKILL.md",
              "fde-output/code-review/**"
            ],
            "write": [
              "fde-output/code-review/**"
            ]
          }
        }
      }
    ],
    "bundles": {
      "code-review": {
        "profile": {
          "skills": [
            "code-review"
          ],
          "providers": {
            "loop": {
              "version": "5.0.0",
              "provider": "fde.code-review"
            }
          }
        },
        "presets": {
          "code-review": {
            "name": "code-review",
            "extends": "standard",
            "model": {
              "route": {
                "primary": {
                  "route": "demo",
                  "model": "demo-model"
                }
              }
            },
            "providers": {
              "tool-policy": {
                "provider": "fde.code-review"
              }
            }
          }
        }
      }
    },
    "metadata": {
      "displayName": "Code review example",
      "summary": "Reviews a synthetic patch for selected risks and prepares an evidence-linked report for a maintainer.",
      "description": "Reviews a synthetic patch for selected risks and prepares an evidence-linked report for a maintainer.",
      "category": "business-agent",
      "samplePrompt": {
        "en": "Review the sample patch: run the debug-log and dynamic-eval checks in parallel, then give me one report listing each finding with its file, line and severity.",
        "zh-CN": "审查这份示例补丁：并行检查调试日志和动态 eval 两类风险，再合并成一份报告，逐条给出文件、行号和严重程度。"
      },
      "locales": {
        "zh-CN": {
          "displayName": "代码审查示例",
          "summary": "检查模拟补丁中的特定风险，为维护者生成附带证据的审查报告。",
          "description": "检查模拟补丁中的特定风险，为维护者生成附带证据的审查报告。"
        }
      }
    }
  },
  "devDependencies": {
    "@agnes/host": "0.0.0",
    "@agnes/resource-control-runtime": "0.0.0",
    "vitest": "5.0.0"
  }
}
