{
  "name": "@agnes-fde/data-report",
  "version": "1.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.10"
  },
  "exports": "./index.mjs",
  "files": [
    "*.mjs",
    "fixtures",
    "skills",
    "client",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "real-model.bundle.json"
  ],
  "scripts": {
    "build": "node --check index.mjs && node --check runtime.mjs",
    "test": "vitest run test/workflow.test.mjs --maxWorkers=1"
  },
  "dependencies": {
    "@agnes/extension-api": "1.4.0",
    "@agnes/plugin-runtime": "0.0.0",
    "@sinclair/typebox": "0.34.33",
    "@agnes/protocol": "0.0.0"
  },
  "agnes": {
    "kinds": [
      "bundle",
      "loop",
      "tool",
      "skills"
    ],
    "capabilities": {
      "model": true,
      "filesystem": {
        "read": [
          "fixtures/*",
          "skills/playbook/SKILL.md",
          "fde-output/data-report/**"
        ],
        "write": [
          "fde-output/data-report/**"
        ]
      }
    },
    "plugins": [
      {
        "export": "main",
        "apiRange": "^1.4.0",
        "id": "ext:@agnes-fde/data-report/main",
        "inject": [
          "extension",
          "loops",
          "toolPolicies",
          "skills"
        ],
        "metadata": {
          "displayName": "Data report example",
          "summary": "Turns a sample CSV into calculated figures, charts and shareable reports.",
          "description": "Turns a sample CSV into calculated figures, charts and shareable reports.",
          "category": "tools",
          "locales": {
            "zh-CN": {
              "displayName": "数据报告示例",
              "summary": "把样例 CSV 转成计算结果、图表和可分享的报告。",
              "description": "把样例 CSV 转成计算结果、图表和可分享的报告。"
            }
          }
        }
      }
    ],
    "bundles": {
      "data-report": {
        "profile": {
          "loop": {
            "id": "fde.data-report",
            "version": "3.0.0"
          },
          "skills": [
            "data-report"
          ]
        },
        "presets": {
          "data-report": {
            "name": "data-report",
            "extends": "standard",
            "approval": {
              "policy": "fde.data-report"
            },
            "model": {
              "route": {
                "primary": {
                  "route": "demo",
                  "model": "demo-model"
                }
              }
            }
          }
        }
      }
    },
    "metadata": {
      "displayName": "Data report example",
      "summary": "Turns a sample CSV into calculated figures, charts and shareable reports.",
      "description": "Turns a sample CSV into calculated figures, charts and shareable reports.",
      "category": "tools",
      "locales": {
        "zh-CN": {
          "displayName": "数据报告示例",
          "summary": "把样例 CSV 转成计算结果、图表和可分享的报告。",
          "description": "把样例 CSV 转成计算结果、图表和可分享的报告。"
        }
      }
    }
  },
  "devDependencies": {
    "@agnes/host": "0.0.0",
    "@agnes/resource-control-runtime": "0.0.0",
    "vitest": "5.0.0"
  }
}
