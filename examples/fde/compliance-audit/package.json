{
  "name": "@agnes-fde/compliance-audit",
  "version": "1.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.10"
  },
  "exports": "./index.mjs",
  "files": [
    "*.mjs",
    "fixtures",
    "skills",
    "client",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "real-model.bundle.json"
  ],
  "scripts": {
    "build": "node --check index.mjs",
    "test": "vitest run test/workflow.test.mjs --maxWorkers=1"
  },
  "dependencies": {
    "@agnes/extension-api": "^4.0.0",
    "@agnes/plugin-runtime": "0.0.0",
    "@sinclair/typebox": "0.34.33",
    "@agnes/protocol": "0.0.0"
  },
  "agnes": {
    "plugins": [
      {
        "export": "main",
        "id": "ext:@agnes-fde/compliance-audit/main",
        "inject": [
          "tools",
          "providers",
          "skills"
        ],
        "apiRange": "^4.0.0",
        "metadata": {
          "displayName": "Compliance evidence example",
          "summary": "Checks local sample evidence against a checklist and reports gaps for human follow-up.",
          "description": "Checks local sample evidence against a checklist and reports gaps for human follow-up.",
          "locales": {
            "zh-CN": {
              "displayName": "合规证据示例",
              "summary": "按清单检查本地样例证据，列出需要人工跟进的缺项。",
              "description": "按清单检查本地样例证据，列出需要人工跟进的缺项。"
            }
          }
        },
        "capabilities": {
          "model": true,
          "filesystem": {
            "read": [
              "fixtures/**",
              "skills/playbook/SKILL.md",
              "fde-output/compliance-audit/**"
            ],
            "write": [
              "fde-output/compliance-audit/**"
            ]
          }
        }
      }
    ],
    "bundles": {
      "compliance-audit": {
        "profile": {
          "skills": [
            "compliance-audit"
          ],
          "providers": {
            "loop": {
              "version": "5.0.0",
              "provider": "fde.compliance-audit"
            }
          }
        },
        "presets": {
          "compliance-audit": {
            "name": "compliance-audit",
            "extends": "standard",
            "providers": {
              "tool-policy": {
                "provider": "fde.compliance-audit"
              }
            }
          }
        },
        "launch": {
          "title": {
            "en": "Compliance evidence example",
            "zh-CN": "合规证据示例"
          },
          "description": {
            "en": "Checks local sample evidence against a checklist and reports gaps for human follow-up."
          },
          "preset": "compliance-audit",
          "prompt": {
            "text": {
              "en": "Audit the sample control checklist against the local evidence files. For each control, tell me whether it is evidenced, a gap or missing, with severity and the source quote.",
              "zh-CN": "对照本地证据文件审计示例控制清单。逐项说明是已有证据、存在缺口还是缺失，并给出严重程度和原文引用。"
            },
            "mode": "draft"
          }
        }
      }
    },
    "metadata": {
      "displayName": "Compliance evidence example",
      "summary": "Checks local sample evidence against a checklist and reports gaps for human follow-up.",
      "description": "Checks local sample evidence against a checklist and reports gaps for human follow-up.",
      "samplePrompt": {
        "en": "Audit the sample control checklist against the local evidence files. For each control, tell me whether it is evidenced, a gap or missing, with severity and the source quote.",
        "zh-CN": "对照本地证据文件审计示例控制清单。逐项说明是已有证据、存在缺口还是缺失，并给出严重程度和原文引用。"
      },
      "locales": {
        "zh-CN": {
          "displayName": "合规证据示例",
          "summary": "按清单检查本地样例证据，列出需要人工跟进的缺项。",
          "description": "按清单检查本地样例证据，列出需要人工跟进的缺项。"
        }
      }
    },
    "provides": [
      "bundle",
      "loop",
      "tool",
      "skills"
    ]
  },
  "devDependencies": {
    "@agnes/host": "0.0.0",
    "@agnes/resource-control-runtime": "0.0.0",
    "vitest": "5.0.0"
  }
}
