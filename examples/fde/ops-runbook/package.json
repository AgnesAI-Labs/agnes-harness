{
  "name": "@agnes-fde/ops-runbook",
  "version": "1.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.10"
  },
  "exports": "./index.mjs",
  "files": [
    "*.mjs",
    "fixtures",
    "skills",
    "client",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "real-model.bundle.json"
  ],
  "scripts": {
    "build": "node --check index.mjs",
    "test": "vitest run test/workflow.test.mjs --maxWorkers=1"
  },
  "dependencies": {
    "@agnes/extension-api": "^3.0.0",
    "@agnes/plugin-runtime": "0.0.0",
    "@sinclair/typebox": "0.34.33",
    "@agnes/protocol": "0.0.0"
  },
  "agnes": {
    "kinds": [
      "bundle",
      "loop",
      "tool",
      "skills"
    ],
    "capabilities": {
      "model": true,
      "filesystem": {
        "read": [
          "fixtures/*",
          "skills/playbook/SKILL.md",
          "fde-output/ops-runbook/**"
        ],
        "write": [
          "fde-output/ops-runbook/**"
        ]
      },
      "exec": [
        "node"
      ]
    },
    "plugins": [
      {
        "export": "main",
        "apiRange": "^3.0.0",
        "id": "ext:@agnes-fde/ops-runbook/main",
        "inject": [
          "tools",
          "providers",
          "skills"
        ],
        "metadata": {
          "displayName": "Operations runbook example",
          "summary": "Reviews sample incidents, runs bounded diagnostics and requests approval before a simulated remediation.",
          "description": "Reviews sample incidents, runs bounded diagnostics and requests approval before a simulated remediation.",
          "category": "tools",
          "locales": {
            "zh-CN": {
              "displayName": "运维手册示例",
              "summary": "检查样例事件、执行受限诊断，并在模拟修复前请求批准。",
              "description": "检查样例事件、执行受限诊断，并在模拟修复前请求批准。"
            }
          }
        }
      }
    ],
    "bundles": {
      "ops-runbook": {
        "profile": {
          "loop": {
            "version": "5.0.0",
            "provider": "fde.ops-runbook"
          },
          "skills": [
            "ops-runbook"
          ],
          "sandbox": {
            "provider": "local"
          }
        },
        "presets": {
          "ops-runbook": {
            "name": "ops-runbook",
            "extends": "standard",
            "model": {
              "route": {
                "primary": {
                  "route": "demo",
                  "model": "demo-model"
                }
              }
            },
            "tool-policy": {
              "provider": "fde.ops-runbook"
            }
          }
        }
      }
    },
    "metadata": {
      "displayName": "Operations runbook example",
      "summary": "Reviews sample incidents, runs bounded diagnostics and requests approval before a simulated remediation.",
      "description": "Reviews sample incidents, runs bounded diagnostics and requests approval before a simulated remediation.",
      "category": "tools",
      "locales": {
        "zh-CN": {
          "displayName": "运维手册示例",
          "summary": "检查样例事件、执行受限诊断，并在模拟修复前请求批准。",
          "description": "检查样例事件、执行受限诊断，并在模拟修复前请求批准。"
        }
      }
    }
  },
  "devDependencies": {
    "@agnes/host": "0.0.0",
    "@agnes/resource-control-runtime": "0.0.0",
    "vitest": "5.0.0"
  }
}
