{
  "name": "@agnes-fde/device-inspection",
  "version": "1.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.10"
  },
  "exports": "./index.mjs",
  "files": [
    "*.mjs",
    "fixtures",
    "skills",
    "client",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "mcp",
    "real-model.bundle.json"
  ],
  "scripts": {
    "build": "node --check index.mjs",
    "test": "vitest run test/workflow.e2e.test.mjs --maxWorkers=1"
  },
  "dependencies": {
    "@agnes/extension-api": "^4.0.0",
    "@agnes/plugin-runtime": "0.0.0",
    "@sinclair/typebox": "0.34.33",
    "@modelcontextprotocol/sdk": "1.25.2",
    "@agnes/protocol": "0.0.0"
  },
  "agnes": {
    "kinds": [
      "bundle",
      "loop",
      "tool",
      "skills",
      "mcp"
    ],
    "plugins": [
      {
        "export": "main",
        "apiRange": "^4.0.0",
        "id": "ext:@agnes-fde/device-inspection/main",
        "inject": [
          "tools",
          "providers",
          "skills"
        ],
        "metadata": {
          "displayName": "Device inspection simulator",
          "summary": "Checks simulated device state and prepares a constrained adjustment for human approval, with preview mode on by default.",
          "description": "Checks simulated device state and prepares a constrained adjustment for human approval, with preview mode on by default.",
          "category": "business-agent",
          "locales": {
            "zh-CN": {
              "displayName": "设备巡检模拟器",
              "summary": "检查模拟设备状态并准备受限调整供人工批准，默认仅预览。",
              "description": "检查模拟设备状态并准备受限调整供人工批准，默认仅预览。"
            }
          }
        },
        "capabilities": {
          "model": true,
          "filesystem": {
            "read": [
              "fixtures/*",
              "skills/playbook/SKILL.md",
              "fde-output/device-inspection/**"
            ],
            "write": [
              "fde-output/device-inspection/**"
            ]
          },
          "device": true,
          "exec": [
            "node"
          ]
        }
      }
    ],
    "bundles": {
      "device-inspection": {
        "profile": {
          "skills": [
            "device-inspection"
          ],
          "providers": {
            "loop": {
              "version": "5.0.0",
              "provider": "fde.device-inspection"
            }
          }
        },
        "presets": {
          "device-inspection": {
            "name": "device-inspection",
            "extends": "standard",
            "model": {
              "route": {
                "primary": {
                  "route": "demo",
                  "model": "demo-model"
                }
              }
            },
            "providers": {
              "tool-policy": {
                "provider": "fde.device-inspection"
              }
            }
          }
        }
      }
    },
    "metadata": {
      "displayName": "Device inspection simulator",
      "summary": "Checks simulated device state and prepares a constrained adjustment for human approval, with preview mode on by default.",
      "description": "Checks simulated device state and prepares a constrained adjustment for human approval, with preview mode on by default.",
      "category": "business-agent",
      "samplePrompt": {
        "en": "Check the sample device's status. If the temperature is out of range, show me the proposed setpoint change and wait for my confirmation before applying it, then verify the receipt.",
        "zh-CN": "检查示例设备的状态。温度超出范围时，先给我看拟调整的设定值并等我确认，再执行并核对回执。"
      },
      "locales": {
        "zh-CN": {
          "displayName": "设备巡检模拟器",
          "summary": "检查模拟设备状态并准备受限调整供人工批准，默认仅预览。",
          "description": "检查模拟设备状态并准备受限调整供人工批准，默认仅预览。"
        }
      }
    }
  },
  "devDependencies": {
    "@agnes/host": "0.0.0",
    "@agnes/resource-control-runtime": "0.0.0",
    "vitest": "5.0.0"
  }
}
