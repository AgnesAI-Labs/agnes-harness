{
  "name": "@agnes-fde/meeting-actions",
  "version": "1.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.10"
  },
  "exports": "./index.mjs",
  "files": [
    "*.mjs",
    "fixtures",
    "skills",
    "client",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "real-model.bundle.json"
  ],
  "scripts": {
    "build": "node --check index.mjs && node --check client/index.js",
    "test": "vitest run test/workflow.test.mjs --maxWorkers=1"
  },
  "dependencies": {
    "@agnes/extension-api": "^3.0.0",
    "@agnes/plugin-runtime": "0.0.0",
    "@sinclair/typebox": "0.34.33",
    "@agnes/protocol": "0.0.0"
  },
  "agnes": {
    "kinds": [
      "bundle",
      "loop",
      "tool",
      "skills",
      "ui"
    ],
    "plugins": [
      {
        "export": "main",
        "id": "ext:@agnes-fde/meeting-actions/main",
        "inject": [
          "tools",
          "providers",
          "skills"
        ],
        "apiRange": "^3.0.0",
        "metadata": {
          "displayName": "Meeting actions example",
          "summary": "Turns a sample meeting transcript into action items and drafts tasks for approval before simulated creation.",
          "description": "Turns a sample meeting transcript into action items and drafts tasks for approval before simulated creation.",
          "category": "collaboration",
          "locales": {
            "zh-CN": {
              "displayName": "会议行动项示例",
              "summary": "把样例会议逐字稿转成行动项，起草任务并在模拟创建前请求批准。",
              "description": "把样例会议逐字稿转成行动项，起草任务并在模拟创建前请求批准。"
            }
          }
        },
        "capabilities": {
          "model": true,
          "filesystem": {
            "read": [
              "fixtures/**",
              "skills/playbook/SKILL.md",
              "fde-output/meeting-actions/**"
            ],
            "write": [
              "fde-output/meeting-actions/**"
            ]
          },
          "ui": true
        }
      }
    ],
    "bundles": {
      "meeting-actions": {
        "profile": {
          "loop": {
            "version": "5.0.0",
            "provider": "fde.meeting-actions"
          },
          "skills": [
            "meeting-actions"
          ]
        },
        "presets": {
          "meeting-actions": {
            "name": "meeting-actions",
            "extends": "standard",
            "model": {
              "route": {
                "primary": {
                  "route": "demo",
                  "model": "demo-model"
                }
              }
            },
            "tool-policy": {
              "provider": "fde.meeting-actions"
            }
          }
        }
      }
    },
    "clientDescriptors": [
      {
        "rowId": "ext:@agnes-fde/meeting-actions/main",
        "path": "./client/agnes.client.json"
      }
    ],
    "metadata": {
      "displayName": "Meeting actions example",
      "summary": "Turns a sample meeting transcript into action items and drafts tasks for approval before simulated creation.",
      "description": "Turns a sample meeting transcript into action items and drafts tasks for approval before simulated creation.",
      "category": "collaboration",
      "locales": {
        "zh-CN": {
          "displayName": "会议行动项示例",
          "summary": "把样例会议逐字稿转成行动项，起草任务并在模拟创建前请求批准。",
          "description": "把样例会议逐字稿转成行动项，起草任务并在模拟创建前请求批准。"
        }
      }
    }
  },
  "devDependencies": {
    "@agnes/host": "0.0.0",
    "@agnes/resource-control-runtime": "0.0.0",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "react": "18.3.1"
  }
}
