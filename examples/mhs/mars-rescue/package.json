{
  "name": "@agnes-example/mars-rescue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./index.mjs",
    "./runtime": "./src/runtime.ts",
    "./simulation": "./src/simulation.ts",
    "./hub-transport": "./src/hub-transport.ts",
    "./access": "./src/access.ts"
  },
  "files": [
    "index.mjs",
    "client",
    "src",
    "skills",
    "assets",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.zh-CN.md",
    "tools"
  ],
  "peerDependencies": {
    "@agnes/web-client": "0.0.0"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run test --project fast --maxWorkers=1",
    "build": "node tools/build.mjs",
    "gen:check": "node tools/build.mjs --check"
  },
  "agnes": {
    "plugins": [
      {
        "id": "ext:agnes-example.mars-rescue",
        "export": "marsRescue",
        "apiRange": "^4.0.0",
        "inject": [
          "skills",
          "profileRuntime"
        ],
        "capabilities": {
          "device": true,
          "ui": true,
          "store": true,
          "managedServices": [
            {
              "id": "fleet",
              "scope": "profile",
              "artifact": {
                "kind": "in-process"
              },
              "healthPath": "/health",
              "listeners": [],
              "startupTimeoutMs": 10000,
              "shutdownTimeoutMs": 5000,
              "apiVersion": "1.0.0",
              "requires": [
                {
                  "extension": "plugin/91109187c405c716",
                  "name": "mhs.producer",
                  "range": "*"
                },
                {
                  "extension": "plugin/91109187c405c716",
                  "name": "mhs.producer.media",
                  "range": "*"
                }
              ]
            }
          ],
          "streams": [
            {
              "name": "mars.devices",
              "scope": "profile",
              "lane": "events",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "fleet": {
                    "type": "string",
                    "minLength": 36,
                    "maxLength": 36
                  }
                },
                "required": [
                  "fleet"
                ],
                "additionalProperties": false
              },
              "directions": [
                "inbound",
                "outbound"
              ],
              "producer": true,
              "maxFrameBytes": 65536,
              "maxBufferedBytes": 131072,
              "maxBytesPerSecond": 262144
            },
            {
              "name": "mars.media",
              "scope": "profile",
              "lane": "media",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "fleet": {
                    "type": "string",
                    "minLength": 36,
                    "maxLength": 36
                  }
                },
                "required": [
                  "fleet"
                ],
                "additionalProperties": false
              },
              "directions": [
                "inbound",
                "outbound"
              ],
              "producer": true,
              "maxFrameBytes": 1048576,
              "maxBufferedBytes": 2097152,
              "maxBytesPerSecond": 4194304
            }
          ]
        },
        "runtime": "in-process"
      }
    ],
    "clientDescriptors": [
      {
        "rowId": "ext:agnes-example.mars-rescue",
        "path": "./client/agnes.client.json"
      }
    ],
    "bundles": {
      "rescue": {
        "profile": {
          "skills": [
            "mars-rescue"
          ]
        },
        "presets": {
          "mars-rescue": {
            "name": "mars-rescue",
            "extends": "standard"
          }
        }
      }
    },
    "metadata": {
      "displayName": "Mars rescue",
      "summary": "Eleven simulated devices, an in-page Mars base and a rescue business Agent.",
      "description": "Simulated rescue and sample missions. Movement requires ordinary MHS approval. No physical hardware is connected.",
      "category": "example",
      "exampleOf": "@agnes/mhs",
      "pageEntry": "mars-rescue",
      "launches": [
        {
          "id": "rescue",
          "kind": "business-agent",
          "title": "Rescue the astronaut",
          "bundle": "@agnes-example/mars-rescue#rescue",
          "preset": "mars-rescue",
          "prompt": "Use the mars-rescue Skill. Read the suit oxygen and base state, locate the astronaut with a hopper camera, then ask approval for movement and have Monolith bring them to the airlock. Prepare medical habitat mode and cycle the airlock safely. Verify the suit rescued state and report receipts; never replay unknown actions."
        },
        {
          "id": "sample",
          "kind": "business-agent",
          "title": "Collect and analyze a sample",
          "bundle": "@agnes-example/mars-rescue#rescue",
          "preset": "mars-rescue",
          "prompt": "Use the mars-rescue Skill. Survey the west field, ask approval for movement, route the rover to rock-1, collect and dock, unload and analyze it in the lab, and send the synthetic result through the comms dish. Verify every result; stop on refusal or unknown motion."
        }
      ],
      "locales": {
        "zh-CN": {
          "displayName": "\u706b\u661f\u6551\u63f4",
          "summary": "11 \u53f0\u6a21\u62df\u8bbe\u5907\u3001\u9875\u5185\u706b\u661f\u57fa\u5730\u4e0e\u6551\u63f4\u4e1a\u52a1 Agent\u3002",
          "description": "\u6a21\u62df\u6551\u63f4\u548c\u91c7\u6837\u4efb\u52a1\uff0c\u8fd0\u52a8\u6cbf\u7528 MHS \u539f\u751f\u6279\u51c6\u3002\u6ca1\u6709\u8fde\u63a5\u7269\u7406\u8bbe\u5907\u3002"
        }
      }
    },
    "kinds": [
      "bundle",
      "skills",
      "ui"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "esbuild": "0.28.2",
    "@agnes/mhs-hub": "workspace:*",
    "@agnes/extension-api": "workspace:*",
    "@agnes/sdk": "workspace:*",
    "@agnes/core": "workspace:*",
    "@agnes/daemon-foundation": "workspace:*",
    "@agnes/host-extensions": "workspace:*",
    "@agnes/host-infrastructure": "workspace:*",
    "@agnes/host": "workspace:*",
    "@agnes/package-manager": "workspace:*",
    "@agnes/plugin-runtime": "workspace:*",
    "@agnes/protocol": "workspace:*",
    "@agnes/worker-runtime": "workspace:*",
    "ws": "8.21.3",
    "@types/ws": "8.18.1"
  },
  "peerDependenciesMeta": {
    "@agnes/web-client": {
      "optional": true
    }
  },
  "dependencies": {
    "@agnes/mhs": "0.1.0-alpha.0",
    "@agnes/mhs-device": "workspace:*"
  }
}
