{
  "name": "@agnes-examples/client-panel",
  "version": "2.0.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "agnes": {
    "plugins": [
      {
        "export": "main",
        "apiRange": "^5.0.0",
        "id": "ext:examples/client-panel/main",
        "runtime": "in-process",
        "metadata": {
          "displayName": "Workbench panel example",
          "summary": "Native workbench.panel compatibility fixture.",
          "description": "Tests the legacy workbench.panel slot. The official workbench does not load this native panel.",
          "locales": {
            "zh-CN": {
              "displayName": "工作台面板示例",
              "summary": "原生 workbench.panel 兼容性测试 fixture。",
              "description": "用于测试旧版 workbench.panel 槽位。官方工作台不会加载此原生面板。"
            }
          }
        }
      }
    ],
    "clientDescriptors": [
      {
        "rowId": "ext:examples/client-panel/main",
        "path": "./extensions/main/agnes.client.json"
      }
    ],
    "metadata": {
      "displayName": "Workbench panel example",
      "summary": "Native workbench.panel compatibility fixture.",
      "description": "Tests the legacy workbench.panel slot. The official workbench does not load this native panel.",
      "locales": {
        "zh-CN": {
          "displayName": "工作台面板示例",
          "summary": "原生 workbench.panel 兼容性测试 fixture。",
          "description": "用于测试旧版 workbench.panel 槽位。官方工作台不会加载此原生面板。"
        }
      }
    },
    "provides": [
      "ui"
    ]
  },
  "exports": "./index.mjs"
}
