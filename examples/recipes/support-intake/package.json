{
  "name": "@agnes-recipe/support-intake",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.10"
  },
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "fixtures",
    "skills",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dependencies": {
    "@agnes/business-recipes": "0.1.0",
    "@agnes/plugin-runtime": "0.0.0",
    "@sinclair/typebox": "0.34.33"
  },
  "agnes": {
    "hostProvidedExternals": {
      "@agnes/plugin-runtime": "0.0.0"
    },
    "kinds": [
      "bundle",
      "loop",
      "tool",
      "skills"
    ],
    "plugins": [
      {
        "export": "main",
        "id": "ext:@agnes-recipe/support-intake/main",
        "apiRange": "^4.0.0",
        "inject": [
          "tools",
          "providers",
          "skills"
        ],
        "capabilities": {
          "model": true,
          "tools": {
            "names": [
              "recipe_support_intake"
            ],
            "prefix": "recipe_"
          }
        }
      }
    ],
    "bundles": {
      "recipe-support-intake-en": {
        "profile": {
          "skills": [
            "recipe-support-intake"
          ],
          "providers": {
            "loop": {
              "version": "5.0.0",
              "provider": "recipe.support-intake"
            }
          },
          "toolPolicy": {
            "readOnly": true
          }
        },
        "presets": {
          "recipe-support-intake-en": {
            "name": "recipe-support-intake-en",
            "extends": "standard",
            "providers": {
              "tool-policy": {
                "provider": "recipe.support-intake"
              }
            }
          }
        }
      },
      "recipe-support-intake-zh-CN": {
        "profile": {
          "skills": [
            "recipe-support-intake"
          ],
          "providers": {
            "loop": {
              "version": "5.0.0",
              "provider": "recipe.support-intake"
            }
          },
          "toolPolicy": {
            "readOnly": true
          }
        },
        "presets": {
          "recipe-support-intake-zh-CN": {
            "name": "recipe-support-intake-zh-CN",
            "extends": "standard",
            "providers": {
              "tool-policy": {
                "provider": "recipe.support-intake"
              }
            }
          }
        }
      }
    },
    "metadata": {
      "displayName": "Support intake",
      "summary": "Synthetic support intake with a review draft.",
      "description": "Input: ticket-104. Output example: Priority P2; route to support; draft a reply for review. Model: selected standard preset primary route. Tools: one read-only recipe tool. No network, filesystem writes or external actions.",
      "category": "example",
      "exampleOf": "@agnes/business-recipes",
      "launches": [
        {
          "id": "ticket-104-en",
          "kind": "business-agent",
          "title": "Support intake · en",
          "bundle": "@agnes-recipe/support-intake#recipe-support-intake-en",
          "preset": "recipe-support-intake-en",
          "prompt": "{\"recipe\":\"support-intake\",\"fixture\":\"ticket-104\",\"language\":\"en\"}"
        },
        {
          "id": "ticket-104-zh-cn",
          "kind": "business-agent",
          "title": "Support intake · zh-CN",
          "bundle": "@agnes-recipe/support-intake#recipe-support-intake-zh-CN",
          "preset": "recipe-support-intake-zh-CN",
          "prompt": "{\"recipe\":\"support-intake\",\"fixture\":\"ticket-104\",\"language\":\"zh-CN\"}"
        }
      ],
      "locales": {
        "zh-CN": {
          "displayName": "客服初筛",
          "summary": "合成客服初筛，生成审查草稿。",
          "description": "输入：ticket-104。产出样例：优先级 P2；转客服；起草回复供审查。 模型：standard 预设的主模型路由。工具：一个只读配方工具；无网络、文件写入或外部操作。"
        }
      }
    }
  }
}
