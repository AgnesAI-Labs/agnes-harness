{
  "name": "@agnes-recipe/meeting-brief",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.10"
  },
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "fixtures",
    "skills",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dependencies": {
    "@agnes/business-recipes": "0.1.0",
    "@agnes/plugin-runtime": "0.0.0",
    "@sinclair/typebox": "0.34.33"
  },
  "agnes": {
    "hostProvidedExternals": {
      "@agnes/plugin-runtime": "0.0.0"
    },
    "kinds": [
      "bundle",
      "loop",
      "tool",
      "skills"
    ],
    "plugins": [
      {
        "export": "main",
        "id": "ext:@agnes-recipe/meeting-brief/main",
        "apiRange": "^4.0.0",
        "inject": [
          "tools",
          "providers",
          "skills"
        ],
        "capabilities": {
          "model": true,
          "tools": {
            "names": [
              "recipe_meeting_brief"
            ],
            "prefix": "recipe_"
          }
        }
      }
    ],
    "bundles": {
      "recipe-meeting-brief-en": {
        "profile": {
          "skills": [
            "recipe-meeting-brief"
          ],
          "providers": {
            "loop": {
              "version": "5.0.0",
              "provider": "recipe.meeting-brief"
            }
          },
          "toolPolicy": {
            "readOnly": true
          }
        },
        "presets": {
          "recipe-meeting-brief-en": {
            "name": "recipe-meeting-brief-en",
            "extends": "standard",
            "providers": {
              "tool-policy": {
                "provider": "recipe.meeting-brief"
              }
            }
          }
        }
      },
      "recipe-meeting-brief-zh-CN": {
        "profile": {
          "skills": [
            "recipe-meeting-brief"
          ],
          "providers": {
            "loop": {
              "version": "5.0.0",
              "provider": "recipe.meeting-brief"
            }
          },
          "toolPolicy": {
            "readOnly": true
          }
        },
        "presets": {
          "recipe-meeting-brief-zh-CN": {
            "name": "recipe-meeting-brief-zh-CN",
            "extends": "standard",
            "providers": {
              "tool-policy": {
                "provider": "recipe.meeting-brief"
              }
            }
          }
        }
      }
    },
    "metadata": {
      "displayName": "Meeting brief",
      "summary": "Synthetic meeting brief with a review draft.",
      "description": "Input: meeting-309. Output example: Morgan: review the pilot checklist, due 2026-11-02. Model: selected standard preset primary route. Tools: one read-only recipe tool. No network, filesystem writes or external actions.",
      "category": "example",
      "exampleOf": "@agnes/business-recipes",
      "launches": [
        {
          "id": "meeting-309-en",
          "kind": "business-agent",
          "title": "Meeting brief · en",
          "bundle": "@agnes-recipe/meeting-brief#recipe-meeting-brief-en",
          "preset": "recipe-meeting-brief-en",
          "prompt": "{\"recipe\":\"meeting-brief\",\"fixture\":\"meeting-309\",\"language\":\"en\"}"
        },
        {
          "id": "meeting-309-zh-cn",
          "kind": "business-agent",
          "title": "Meeting brief · zh-CN",
          "bundle": "@agnes-recipe/meeting-brief#recipe-meeting-brief-zh-CN",
          "preset": "recipe-meeting-brief-zh-CN",
          "prompt": "{\"recipe\":\"meeting-brief\",\"fixture\":\"meeting-309\",\"language\":\"zh-CN\"}"
        }
      ],
      "locales": {
        "zh-CN": {
          "displayName": "会议简报",
          "summary": "合成会议简报，生成审查草稿。",
          "description": "输入：meeting-309。产出样例：Morgan：审查试点清单，截止 2026-11-02。 模型：standard 预设的主模型路由。工具：一个只读配方工具；无网络、文件写入或外部操作。"
        }
      }
    }
  }
}
