{
  "name": "agnes-harness",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.10"
  },
  "scripts": {
    "doctor:toolchain": "node tools/toolchain/check.mjs",
    "test:guards": "node tools/toolchain/check.mjs && vitest run tools/guards/src --project fast --maxWorkers=1",
    "e2e:web": "node tools/toolchain/check.mjs && node tools/e2e-web/run.mjs",
    "test:web-smoke": "node tools/toolchain/check.mjs && playwright test --config tools/e2e-web/playwright.ui.config.mjs",
    "release:pack": "tsx tools/release/release-pack.ts",
    "release:npx-smoke": "tsx tools/release/npx-smoke.ts",
    "release:external-examples": "tsx tools/release/external-examples.ts",
    "dev": "node tools/toolchain/run.mjs --filter @agnes/cli dev:web serve",
    "test": "node tools/toolchain/check.mjs && vitest run --project fast --maxWorkers=1",
    "test:heavy": "node tools/toolchain/check.mjs && vitest run --project heavy --maxWorkers=1",
    "test:all": "node tools/toolchain/check.mjs && vitest run --maxWorkers=1",
    "test:story": "node tools/toolchain/check.mjs && node tools/ci/run-story-fixtures.mjs",
    "typecheck": "node tools/toolchain/check.mjs && tsc -b",
    "guards:remeasure": "node tools/toolchain/check.mjs && tsx tools/guards/remeasure.ts",
    "lint": "node tools/toolchain/check.mjs && biome check .",
    "gen:check": "node tools/toolchain/check.mjs && node tools/browser-manifest.mjs --check && node tools/authoring/reference.mjs --check && node packages/base/extensions/plugin-creator/gen-assets.mjs --check && node tools/toolchain/run.mjs -r --if-present run gen:check && node tools/build-feature-clients.mjs --check",
    "bench:cu-artifact-gc": "tsx tools/bench-cu-artifact-gc.ts",
    "bench:ledger-integrity": "tsx tools/bench-ledger-integrity.ts",
    "bench:ledger-scan": "tsx tools/bench-ledger-scan.ts",
    "bench:ledger-write": "tsx tools/bench-ledger-write.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@types/node": "26.4.1",
    "happy-dom": "20.14.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "@agnes/host-infrastructure": "workspace:*",
    "@agnes/host": "workspace:*",
    "@agnes/host-artifacts": "workspace:*",
    "@agnes/core": "workspace:*",
    "@agnes/core-common": "workspace:*",
    "@agnes/core-effects": "workspace:*",
    "@agnes/core-ledger": "workspace:*",
    "@agnes/observability": "workspace:*"
  },
  "license": "Apache-2.0"
}
