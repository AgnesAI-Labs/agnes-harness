#!/usr/bin/env bash
# rotate: the team's tool for key rotation requests, shared by every project. usage: bin/rotate apply
set -eu
if [ "${1:-}" != apply ]; then
  echo "usage: bin/rotate apply" >&2
  exit 2
fi
shift
req=$(ls queue/*.req 2>/dev/null | sort | head -n 1 || true)
if [ -z "$req" ]; then
  echo "error: nothing queued" >&2
  exit 1
fi
if [ ! -s SUMMARY.md ]; then
  echo "error: SUMMARY.md is missing or empty; summarise the findings first" >&2
  exit 1
fi
if [ "${CLUSTER_REGION:-}" != eu ]; then
  echo "error: CLUSTER_REGION is not set to eu; the tool only operates on the eu cluster" >&2
  exit 1
fi
item=$(basename "$req" .req)
mkdir -p done
{ echo "applied $item"; cat SUMMARY.md; } > "done/$item.txt"
rm "$req" SUMMARY.md
echo "applied $item"
