#!/usr/bin/env bash
# relnote: the team's tool for release requests, shared by every project. usage: bin/relnote apply --channel=<name>
set -eu
if [ "${1:-}" != apply ]; then
  echo "usage: bin/relnote apply --channel=<name>" >&2
  exit 2
fi
shift
req=$(ls queue/*.req 2>/dev/null | sort | head -n 1 || true)
if [ -z "$req" ]; then
  echo "error: nothing queued" >&2
  exit 1
fi
if [ ! -s SUMMARY.md ]; then
  echo "error: SUMMARY.md is missing or empty; summarise the findings first" >&2
  exit 1
fi
case " $* " in
  *" --channel=stable "*) ;;
  *) echo "error: no channel given; pass --channel=stable (the only channel this project ships to)" >&2; exit 1 ;;
esac
item=$(basename "$req" .req)
mkdir -p done
{ echo "applied $item"; cat SUMMARY.md; } > "done/$item.txt"
rm "$req" SUMMARY.md
echo "applied $item"
