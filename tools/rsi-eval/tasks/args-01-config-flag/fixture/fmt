#!/usr/bin/env python3
import sys


def fail(message, code=2):
    print(f'error: {message}', file=sys.stderr)
    sys.exit(code)


args = sys.argv[1:]
config_path = None
files = []
while args:
    arg = args.pop(0)
    if arg == '--config':
        if not args:
            fail('--config needs a file')
        config_path = args.pop(0)
    else:
        files.append(arg)

if config_path is None:
    fail('--config <file> is required (the project config is fmt.cfg)')
if len(files) != 1:
    fail('usage: ./fmt --config <file> <input>')

options = {}
with open(config_path) as handle:
    for line in handle:
        key, _, value = line.rstrip('\n').partition('=')
        options[key] = value

with open(files[0]) as handle:
    for line in handle:
        text = line.rstrip('\n')
        if options.get('case') == 'upper':
            text = text.upper()
        print(options.get('prefix', '') + text)
