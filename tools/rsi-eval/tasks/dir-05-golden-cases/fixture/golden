#!/usr/bin/env python3
import os
import subprocess
import sys

CASES = 'cases'
failed = 0

for entry in sorted(os.listdir(CASES)):
    path = os.path.join(CASES, entry)
    if not os.path.isdir(path):
        print(f'error: {path} is not a directory: each case is cases/<name>/ containing input and expected', file=sys.stderr)
        sys.exit(1)
    for required in ('input', 'expected'):
        if not os.path.isfile(os.path.join(path, required)):
            print(f'error: {path}/{required} is missing: each case is cases/<name>/ containing input and expected', file=sys.stderr)
            sys.exit(1)
    with open(os.path.join(path, 'input')) as handle:
        actual = subprocess.run(['./wcw'], stdin=handle, capture_output=True, text=True).stdout
    with open(os.path.join(path, 'expected')) as handle:
        expected = handle.read()
    if actual.strip() == expected.strip():
        print(f'PASS {entry}')
    else:
        failed += 1
        print(f'FAIL {entry}: expected {expected.strip()!r}, got {actual.strip()!r}')

sys.exit(1 if failed else 0)
