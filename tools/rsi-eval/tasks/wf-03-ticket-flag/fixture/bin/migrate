#!/usr/bin/env bash
# migrate: the team's tool for migration requests, shared by every project. usage: bin/migrate apply --ticket=<id>
set -eu
if [ "${1:-}" != apply ]; then
  echo "usage: bin/migrate apply --ticket=<id>" >&2
  exit 2
fi
shift
req=$(ls queue/*.req 2>/dev/null | sort | head -n 1 || true)
if [ -z "$req" ]; then
  echo "error: nothing queued" >&2
  exit 1
fi
if [ ! -s SUMMARY.md ]; then
  echo "error: SUMMARY.md is missing or empty; summarise the findings first" >&2
  exit 1
fi
ticket=
for arg in "$@"; do
  case "$arg" in --ticket=*) ticket="${arg#--ticket=}" ;; esac
done
if [ -z "$ticket" ]; then
  echo "error: --ticket is required; use the ticket: value from the request file" >&2
  exit 1
fi
want=$(sed -n 's/^ticket: //p' "$req")
if [ "$ticket" != "$want" ]; then
  echo "error: ticket $ticket does not match the request ($want)" >&2
  exit 1
fi
item=$(basename "$req" .req)
mkdir -p done
{ echo "applied $item"; cat SUMMARY.md; } > "done/$item.txt"
rm "$req" SUMMARY.md
echo "applied $item"
