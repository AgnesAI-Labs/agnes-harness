#!/usr/bin/env bash
# ship: the team's deploy tool, shared by every project. usage: bin/ship [--plan] <target>
set -eu
plan=0
if [ "${1:-}" = --plan ]; then
  plan=1
  shift
fi
target="${1:-}"
if [ -z "$target" ]; then
  echo "usage: bin/ship [--plan] <target>" >&2
  exit 2
fi
if [ ! -f "targets/$target" ]; then
  echo "error: unknown target $target" >&2
  exit 1
fi
if [ "$plan" = 1 ]; then
  mkdir -p .ship
  echo "plan for $target" > ".ship/$target.plan"
  echo "planned $target (nothing deployed)"
  exit 0
fi
if [ ! -f ".ship/$target.plan" ]; then
  echo "error: no reviewed plan for '$target'; run bin/ship --plan $target first" >&2
  exit 1
fi
mkdir -p deployed
echo "deployed $target" > "deployed/$target.txt"
rm ".ship/$target.plan"
echo "deployed $target"
