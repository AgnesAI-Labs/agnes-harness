#!/usr/bin/env bash
# pkg: the team's dependency tool, shared by every project. usage: bin/pkg add <name> [--registry <name>]
set -eu
cmd="${1:-}"
name="${2:-}"
if [ "$cmd" != add ] || [ -z "$name" ]; then
  echo "usage: bin/pkg add <name> [--registry <name>]" >&2
  exit 2
fi
shift 2
registry=public
while [ $# -gt 0 ]; do
  case "$1" in
    --registry) registry="${2:-}"; shift 2 ;;
    *) echo "error: unknown option $1" >&2; exit 2 ;;
  esac
done
if [ "$registry" != internal ]; then
  echo "error: registry '$registry' is unreachable from this machine; use --registry internal" >&2
  exit 1
fi
touch deps.txt
grep -qx "$name@internal" deps.txt || echo "$name@internal" >> deps.txt
echo "added $name from internal"
