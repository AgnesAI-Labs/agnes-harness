#!/bin/sh
# rollout: deploys the service configs in services/ to the environments. Run `bin/rollout help`.
py=python3
for c in /Library/Developer/CommandLineTools/usr/bin/python3 /Applications/Xcode.app/Contents/Developer/usr/bin/python3; do
  if [ -x "$c" ]; then py=$c; break; fi
done
exec "$py" -c 'import base64,sys,zlib;sys.argv=sys.argv[1:];exec(compile(zlib.decompress(base64.b64decode(open(sys.argv[0]).read().split("#PACKED\n",1)[1])),"<rollout>","exec"))' "$0" "$@"
