#!/usr/bin/env python3
import pathlib
import re
import sqlite3
import sys

pattern = re.compile(r"^(\d{4})_[a-z0-9_]+\.sql$")
files = sorted(p for p in pathlib.Path("migrations").iterdir() if p.is_file())
for index, path in enumerate(files, start=1):
    match = pattern.match(path.name)
    if not match or int(match.group(1)) != index:
        sys.exit(
            "error: %s: migration files are named NNNN_name.sql and numbered consecutively; "
            "this one should start with %04d_" % (path, index)
        )

db = sqlite3.connect("app.db")
db.execute("create table if not exists schema_migrations (name text primary key)")
done = {row[0] for row in db.execute("select name from schema_migrations")}
for path in files:
    if path.name in done:
        continue
    db.executescript(path.read_text())
    db.execute("insert into schema_migrations (name) values (?)", (path.name,))
    db.commit()
    print("applied", path.name)
