{
  "id": "xws-02-semicolon-csv",
  "category": "cross-workspace",
  "description": "The team's shared csvload tool, used by two unrelated projects, only reads CSV files separated by semicolons.",
  "trap": {
    "signatures": ["expected ';' as the field separator"],
    "reproduce": "printf 'name,qty\\nx,1\\n' > probe.csv && tools/csvload probe.csv probe",
    "note": "The shared tools/csvload only accepts ';' as the CSV field separator (name;qty), never commas, in every project that has it."
  },
  "sessions": [
    {
      "prompts": [
        {
          "text": "Load this stock list into the `stock` table with the team's csvload tool: bolt 120, nut 300. Write it as a CSV file with a header row `item`, `qty` first.",
          "checks": [
            {
              "command": "cat tables/stock.txt",
              "contains": "bolt=120"
            },
            {
              "command": "cat tables/stock.txt",
              "contains": "nut=300"
            }
          ],
          "solution": [
            "printf 'item;qty\\nbolt;120\\nnut;300\\n' > stock.csv",
            "tools/csvload stock.csv stock"
          ]
        },
        {
          "text": "Load this list into the `bins` table with the team's csvload tool: A1 holds 12 washers, B4 holds 40 hinges. Write it as a CSV file with a header row `bin`, `part`, `count` first.",
          "checks": [
            {
              "command": "cat tables/bins.txt",
              "contains": "A1=washers=12"
            },
            {
              "command": "cat tables/bins.txt",
              "contains": "B4=hinges=40"
            }
          ],
          "solution": [
            "printf 'bin;part;count\\nA1;washers;12\\nB4;hinges;40\\n' > bins.csv",
            "tools/csvload bins.csv bins"
          ]
        },
        {
          "text": "Load this supplier list into the `suppliers` table with the team's csvload tool: Acme in Lyon, Brio in Turin. Write it as a CSV file with a header row `name`, `city` first.",
          "checks": [
            {
              "command": "cat tables/suppliers.txt",
              "contains": "Acme=Lyon"
            },
            {
              "command": "cat tables/suppliers.txt",
              "contains": "Brio=Turin"
            }
          ],
          "solution": [
            "printf 'name;city\\nAcme;Lyon\\nBrio;Turin\\n' > suppliers.csv",
            "tools/csvload suppliers.csv suppliers"
          ]
        }
      ]
    },
    {
      "fixture": "fixture-b",
      "prompts": [
        {
          "text": "Load these weekly hours into the `hours` table with the team's csvload tool: ana 38, ben 40. Write it as a CSV file with a header row `person`, `hours` first.",
          "checks": [
            {
              "command": "cat tables/hours.txt",
              "contains": "ana=38"
            },
            {
              "command": "cat tables/hours.txt",
              "contains": "ben=40"
            }
          ],
          "solution": [
            "printf 'person;hours\\nana;38\\nben;40\\n' > hours.csv",
            "tools/csvload hours.csv hours"
          ]
        },
        {
          "text": "Load these rates into the `rates` table with the team's csvload tool: junior 21, senior 34. Write it as a CSV file with a header row `grade`, `rate` first.",
          "checks": [
            {
              "command": "cat tables/rates.txt",
              "contains": "junior=21"
            },
            {
              "command": "cat tables/rates.txt",
              "contains": "senior=34"
            }
          ],
          "solution": [
            "printf 'grade;rate\\njunior;21\\nsenior;34\\n' > rates.csv",
            "tools/csvload rates.csv rates"
          ]
        },
        {
          "text": "Load this leave list into the `leave` table with the team's csvload tool: ana takes 3 days in May, ben 5 days in June. Write it as a CSV file with a header row `person`, `days`, `month` first.",
          "checks": [
            {
              "command": "cat tables/leave.txt",
              "contains": "ana=3=May"
            },
            {
              "command": "cat tables/leave.txt",
              "contains": "ben=5=June"
            }
          ],
          "solution": [
            "printf 'person;days;month\\nana;3;May\\nben;5;June\\n' > leave.csv",
            "tools/csvload leave.csv leave"
          ]
        }
      ]
    }
  ]
}
