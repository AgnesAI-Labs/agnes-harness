#!/usr/bin/env python3
import glob
import sys

if len(sys.argv) != 2:
    got = len(sys.argv) - 1
    print(
        f"error: expected exactly one pattern but got {got} arguments; quote the pattern so tally expands it itself, e.g. ./tally 'logs/*.txt'",
        file=sys.stderr,
    )
    sys.exit(2)

files = sorted(glob.glob(sys.argv[1]))
lines = 0
for name in files:
    with open(name) as handle:
        lines += sum(1 for _ in handle)
print(f'files: {len(files)} lines: {lines}')
