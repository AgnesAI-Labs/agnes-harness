# Source and signed/frozen fixtures must have identical bytes on all checkouts.
# Keep binary files untouched; Windows batch launchers may require CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
# Unified patches retain LF bytes and the required space on blank context lines.
integrations/llmsg/*.patch -text whitespace=-blank-at-eol,-space-before-tab
